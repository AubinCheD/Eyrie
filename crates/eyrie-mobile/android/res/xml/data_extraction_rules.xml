<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et suivants : rien ne part, ni dans une sauvegarde du nuage, ni dans un transfert d'un téléphone à un
     autre (android:allowBackup="false" n'arrête pas ce transfert chez certains fabricants). La clé de l'appareil
     (identite) et les clés de démarrage des PC (pcs.json) restent sur ce téléphone : un autre s'appaire de nouveau. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
