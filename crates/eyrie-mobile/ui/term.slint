// Un terminal du PC, en direct : la grille (couleurs résolues dans le thème du téléphone), ajustée à la largeur de
// l'écran ; deux doigts la zooment (le zoom est gardé). Dessous : réponses rapides quand Claude attend, barre de touches
// (Ctrl et Alt collants, coller, copier, saisie masquée), champ de saisie (sur plusieurs lignes, il part en collage),
// avec son micro (la dictée). Un appui long sur la sortie, ou « Copier », montre son texte dans un champ en lecture
// seule, où l'on sélectionne ce qu'on copie.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton, ActButton, MicButton, ListenLine } from "widgets.slint";

export struct TermSeg {
    col: int,
    len: int,
    text: string,
    fg: color,
    bg: color,
    has-bg: bool,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermRow {
    segs: [TermSeg],
}

// Une touche de la barre : son nom pour le code, et si elle prend Ctrl ou Alt collé (sinon elle part seule).
export struct TermKey {
    label: string,
    key: string,
    ctrl: bool,
    alt: bool,
}

// Une touche : 44 px de côté au moins. Collée (Ctrl, Alt) : pleine et soulignée, comme enfoncée ; pâle : elle ne
// prend pas ce qui est collé.
component KeyChip inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    in property <bool> latchable;
    in property <bool> latched;
    in property <bool> dim;
    callback clicked();
    height: 44px;
    width: max(44px, t.preferred-width + 24px);
    border-radius: 12px;
    background: root.latched ? (ta.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : ta.pressed ? Theme.pressed : (root.accent ? Theme.accent-soft : Theme.surface-2);
    opacity: root.dim ? 0.45 : 1;
    animate background { duration: 80ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: root.latchable;
    accessible-checked: root.latched;
    accessible-action-default => { root.clicked(); }
    t := Text {
        text: root.text;
        color: root.latched ? Theme.on-accent : root.accent ? Theme.accent : Theme.text;
        font-size: 14px;
        font-weight: root.latched ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.latched: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 8px;
        width: 18px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.on-accent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Le texte du terminal à copier (l'historique gardé compris), figé à l'ouverture : on y sélectionne (appui long, puis
// les poignées) et « Copier » ; sans sélection, tout part.
component CopySheet inherits Rectangle {
    in property <string> text;
    // La sélection de départ (octets) : la ligne d'un appui long ; égales, le curseur seul (à la fin : le bas visible).
    in property <int> anchor;
    in property <int> focus-at;
    callback close();
    callback copied(bool);
    property <bool> selecting: field.anchor-position-byte-offset != field.cursor-position-byte-offset;
    // La sélection de départ vient d'être posée : elle se montre au milieu.
    property <bool> placing;
    background: Theme.surface;
    // Rien ne passe au terminal dessous.
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            height: 64px;
            padding-left: Theme.pad;
            padding-right: 6px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "Copier du terminal";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: "Appui long sur le texte pour sélectionner, puis Copier.";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "close";
                    label: "Fermer";
                    clicked => { root.close(); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.term-bg;
            clip: true;
            flick := Flickable {
                x: 12px;
                width: parent.width - 24px;
                // La souris sélectionne (bureau) ; le doigt fait défiler (dans les deux sens), l'appui long sélectionne.
                mouse-drag-pan-enabled: false;
                content-width: max(self.width, field.preferred-width + 12px);
                content-height: max(self.height, field.preferred-height + 24px);
                // Les lignes du terminal gardent leurs colonnes (cadres, tableaux, diffs) : rien ne passe à la ligne, le
                // texte défile de côté.
                field := TextInput {
                    x: 0;
                    y: 12px;
                    width: max(flick.width, self.preferred-width);
                    height: max(flick.height - 24px, self.preferred-height);
                    text: root.text;
                    read-only: true;
                    single-line: false;
                    wrap: no-wrap;
                    vertical-alignment: top;
                    font-family: "Hack";
                    font-size: 13px;
                    color: Theme.term-fg;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.term-fg;
                    accessible-label: "Texte du terminal";
                    // Le curseur (le bout de la sélection) reste visible ; la ligne d'un appui long se montre au milieu, depuis
                    // son début.
                    cursor-position-changed(p) => {
                        if root.placing {
                            root.placing = false;
                            flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, flick.height / 2 - p.y - 12px));
                            flick.content-x = 0;
                        } else {
                            if p.y + 12px + flick.content-y < 0 {
                                flick.content-y = min(0px, 8px - p.y - 12px);
                            } else if p.y + 52px + flick.content-y > flick.height {
                                flick.content-y = flick.height - p.y - 52px;
                            }
                            if p.x + flick.content-x < 0 {
                                flick.content-x = min(0px, 8px - p.x);
                            } else if p.x + 24px + flick.content-x > flick.width {
                                flick.content-x = flick.width - p.x - 24px;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 64px;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;
            alignment: end;
            ActButton {
                text: "Tout sélectionner";
                clicked => { field.select-all(); }
            }
            ActButton {
                text: root.selecting ? "Copier" : "Tout copier";
                style: 1;
                clicked => {
                    if root.selecting {
                        field.copy();
                        root.copied(false);
                    } else {
                        field.select-all();
                        field.copy();
                        root.copied(true);
                    }
                }
            }
        }
    }
    // Après la première mise en page : le champ prend le focus (l'appui long d'Android y sélectionne), puis la
    // sélection de départ.
    Timer {
        interval: 40ms;
        running: true;
        triggered => {
            self.running = false;
            field.focus();
            root.placing = root.focus-at > 0;
            field.set-selection-offsets(root.anchor, root.focus-at);
        }
    }
}

export component TermView inherits Rectangle {
    in property <[TermRow]> rows;
    in property <int> cols: 80;
    in property <int> cursor-row: -1;
    in property <int> cursor-col;
    // Le zoom de la police (1 : ajustée à la largeur). Le pincement, A− et A+ le changent ici, puis le disent
    // (`zoomed`) pour qu'il soit gardé.
    in-out property <float> zoom: 1.0;
    in property <bool> ended;
    in property <bool> waiting;
    in property <[string]> replies;
    in property <bool> can-type: true;
    in-out property <string> draft;
    // La saisie masquée, pour un mot de passe : ni affichée, ni apprise ou suggérée par le clavier du téléphone (un
    // champ de mot de passe pour le système).
    in-out property <bool> masked;
    // Ce qui est collé (tenu par le code) : 0 rien, 1 Ctrl, 2 Alt.
    in property <int> latch;
    // Le texte à copier, figé à l'ouverture, et sa sélection de départ (octets).
    in property <string> copy-text;
    in property <int> copy-anchor;
    in property <int> copy-focus;
    in-out property <bool> copy-visible;
    // La dictée (voir `dictee.rs`) : le micro se montre si le téléphone sait reconnaître la parole, que la saisie est
    // permise et n'est pas masquée (jamais un mot de passe). `listening` : il écoute pour ce terminal (micro rouge,
    // « J'écoute… » et le texte provisoire au-dessus du champ) ; `sends` : le texte dicté partira aussitôt (réglage).
    in property <bool> can-dictate;
    in property <bool> listening;
    in property <bool> dictation-stopping;
    in property <string> heard;
    in property <float> level;
    in property <bool> sends;
    // Le bas de la liste est visible.
    out property <bool> at-bottom: list.content-y <= list.visible-height - root.content-h + 2 * root.ch;
    // La liste suit le bas tant que l'utilisateur ne l'a pas remontée : la sortie qui arrive y reste collée, et le bas
    // reste en vue quand la hauteur change (clavier du téléphone qui s'ouvre, réponses rapides, zoom).
    out property <bool> follow: true;
    // La hauteur des barres sous la liste : les bulles se posent au-dessus.
    out property <length> bars-height: (root.waiting && root.replies.length > 0 ? 56px : 0) + 56px + listen-bar.height + root.input-h + 16px;
    callback send-line(string);
    callback key(string);
    // Ctrl (1) ou Alt (2) touché : il se colle, ou se relâche ; `unlatch` : il se relâche.
    callback latch-key(int);
    callback unlatch();
    // Un caractère tapé au clavier du téléphone pendant que Ctrl ou Alt est collé.
    callback typed(string);
    // Le texte du presse-papiers, à coller.
    callback paste(string);
    // Le texte à copier, cette ligne sélectionnée (-1 : aucune) ; copié (`true` : tout le texte).
    callback copy(int);
    callback copied(bool);
    callback reply(int);
    callback zoomed(float);
    callback haptic();
    // Le micro touché ; l'écoute à abandonner (la saisie s'est masquée).
    callback dictate();
    callback dictation-cancel();

    // Ajusté à la largeur : la police mono (Hack) avance de 0,602 em par caractère.
    property <length> fit-font: (root.width - 30px) / (max(root.cols, 20) * 0.602);
    property <length> fs: max(5px, min(30px, root.fit-font * root.zoom));
    out property <length> cw: root.fs * 0.602;
    out property <length> ch: ceil(root.fs * 1.22 / 1px) * 1px;
    property <length> content-h: root.rows.length * root.ch;
    property <length> list-h: list.visible-height;
    // Le champ de saisie grandit avec ses lignes, jusqu'à cinq environ.
    property <length> input-h: min(116px, max(42px, input.preferred-height + 20px));

    public function scroll-to-end() {
        root.follow = true;
        list.content-y = min(0px, list.visible-height - root.content-h);
    }

    // Un autre zoom : la liste garde le bas qu'elle suivait, sinon la ligne et la colonne du haut.
    function set-zoom(z: float) {
        let top = -list.content-y / root.ch;
        let left = -list.content-x / root.cw;
        root.zoom = max(0.6, min(3.0, z));
        if root.follow {
            root.scroll-to-end();
        } else {
            list.content-y = max(min(0px, list.visible-height - root.content-h), -top * root.ch);
        }
        list.content-x = max(min(0px, list.visible-width - list.content-width), -left * root.cw);
    }

    // Le presse-papiers, lu par un champ caché (le système ne le donne qu'à un champ de texte).
    function paste-clipboard() {
        clip.text = "";
        clip.paste();
        root.paste(clip.text);
        clip.text = "";
    }

    changed content-h => {
        if root.follow {
            root.scroll-to-end();
        }
    }
    changed list-h => {
        if root.follow {
            root.scroll-to-end();
        }
    }
    changed at-bottom => {
        if root.at-bottom {
            root.follow = true;
        }
    }

    // Ctrl ou Alt collé : la touche suivante tapée au clavier du téléphone arrive dans `catcher` (qui ouvre le clavier
    // s'il était fermé). Relâché : le champ de saisie reprend le focus s'il l'avait.
    property <bool> had-field;
    property <bool> catching: catcher.has-focus;
    changed latch => {
        if root.latch != 0 {
            if !catcher.has-focus {
                root.had-field = input.has-focus;
                catcher.focus();
            }
        } else if catcher.has-focus {
            if root.had-field {
                input.focus();
            } else {
                catcher.clear-focus();
            }
        }
    }
    // Le champ de saisie touché pendant que Ctrl ou Alt était collé (ou le texte à copier ouvert) : il se relâche.
    changed catching => {
        if !root.catching && root.latch != 0 {
            root.unlatch();
        }
    }

    // La saisie : Entrée envoie ; Maj+Entrée (clavier physique) va à la ligne dans le champ. Un clavier qui donne
    // Entrée comme du texte (un retour ajouté au bout) envoie aussi.
    property <string> last-draft;
    property <bool> shift-return;
    changed draft => {
        root.last-draft = root.draft;
    }
    // Le clavier ne relit le genre du champ qu'à sa prise de focus : il la reprend, pour que la lettre suivante soit
    // déjà masquée (ou de nouveau visible). Masquée, la saisie ne prend pas de dictée : l'écoute s'abandonne.
    changed masked => {
        if input.has-focus {
            input.clear-focus();
            input.focus();
        }
        if root.masked && root.listening {
            root.dictation-cancel();
        }
    }

    // Les touches de la barre, de part et d'autre de Coller et Copier (voir `termkeys.rs` pour ce qu'elles prennent
    // de Ctrl ou Alt collé).
    property <[TermKey]> first-keys: [
        { label: "Échap", key: "escape" },
        { label: "Tab", key: "tab" },
        { label: "↑", key: "up" },
        { label: "↓", key: "down" },
        { label: "←", key: "left" },
        { label: "→", key: "right" },
        { label: "Entrée", key: "enter" },
        { label: "Ctrl+C", key: "ctrl-c", ctrl: true },
    ];
    property <[TermKey]> more-keys: [
        { label: "Maj+Tab", key: "backtab" },
        { label: "Maj+Entrée", key: "shift-enter" },
        { label: "Effacer", key: "backspace", ctrl: true, alt: true },
        { label: "Ctrl+D", key: "ctrl-d", ctrl: true },
        { label: "Ctrl+R", key: "ctrl-r", ctrl: true },
        { label: "Ctrl+L", key: "ctrl-l", ctrl: true },
        { label: "Ctrl+Z", key: "ctrl-z", ctrl: true },
        { label: "Début", key: "home" },
        { label: "Fin", key: "end" },
        { label: "Page ↑", key: "pageup" },
        { label: "Page ↓", key: "pagedown" },
    ];

    background: Theme.term-bg;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            pinch := ScaleRotateGestureHandler {
                property <float> start-zoom;
                started => {
                    self.start-zoom = root.zoom;
                }
                updated => {
                    root.set-zoom(self.start-zoom * self.scale);
                }
                ended => {
                    root.zoomed(root.zoom);
                }
                cancelled => {
                    root.zoomed(root.zoom);
                }

                list := ListView {
                    width: parent.width;
                    height: parent.height;
                    content-width: root.cols * root.cw + 12px > self.visible-width + 1px ? root.cols * root.cw + 12px : self.visible-width;
                    scrolled => {
                        if !root.at-bottom {
                            root.follow = false;
                        }
                    }
                    for row[i] in root.rows: line := Rectangle {
                        // L'appui long a déjà ouvert le texte à copier : relâcher ne fait rien de plus.
                        property <bool> held;
                        height: root.ch;
                        for seg in row.segs: Rectangle {
                            x: 6px + seg.col * root.cw;
                            width: seg.len * root.cw;
                            height: root.ch;
                            background: seg.has-bg ? seg.bg : transparent;
                            Text {
                                x: 0;
                                text: seg.text;
                                color: seg.fg;
                                font-family: "Hack";
                                font-size: root.fs;
                                font-weight: seg.bold ? 700 : 400;
                                font-italic: seg.italic;
                                vertical-alignment: center;
                            }
                            if seg.underline: Rectangle {
                                y: root.ch - 2px;
                                height: 1px;
                                background: seg.fg;
                            }
                        }
                        if i == root.cursor-row: Rectangle {
                            x: 6px + root.cursor-col * root.cw;
                            width: max(2px, root.cw);
                            height: root.ch;
                            background: Theme.accent.with-alpha(0.55);
                        }
                        // Un appui long : le texte du terminal à copier, cette ligne sélectionnée.
                        hold := TouchArea {
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    line.held = false;
                                }
                            }
                        }
                        Timer {
                            interval: 520ms;
                            running: hold.pressed && !line.held;
                            triggered => {
                                line.held = true;
                                root.haptic();
                                root.copy(i);
                            }
                        }
                    }
                }
            }
            // Ctrl ou Alt collé : ce qu'il attend.
            if root.latch != 0: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 12px;
                width: hint.preferred-width + 28px;
                height: 36px;
                border-radius: 18px;
                background: Theme.accent;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000044;
                hint := Text {
                    text: root.latch == 1 ? "Ctrl collé : tapez une lettre" : "Alt collé : tapez une touche";
                    color: Theme.on-accent;
                    font-size: 13.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            // Revenir en bas, quand on a remonté l'historique.
            if !root.at-bottom: Rectangle {
                x: parent.width - 60px;
                y: parent.height - 60px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.surface;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000044;
                accessible-role: button;
                accessible-label: "Revenir en bas";
                accessible-action-default => { root.scroll-to-end(); }
                Icon {
                    kind: "down";
                    tint: Theme.accent;
                }
                TouchArea {
                    clicked => { root.scroll-to-end(); }
                }
            }
        }

        if root.waiting && root.replies.length > 0: Rectangle {
            height: 56px;
            background: Theme.warn.with-alpha(0.12);
            Flickable {
                content-width: replies-row.preferred-width;
                replies-row := HorizontalLayout {
                    padding: 6px;
                    spacing: 8px;
                    for r[i] in root.replies: KeyChip {
                        text: r;
                        accent: true;
                        clicked => {
                            root.haptic();
                            root.reply(i);
                        }
                    }
                }
            }
        }

        // Touches que le clavier du téléphone n'a pas.
        Rectangle {
            height: 56px;
            background: Theme.surface;
            Flickable {
                content-width: keys-row.preferred-width;
                keys-row := HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;
                    KeyChip {
                        text: "Ctrl";
                        latchable: true;
                        latched: root.latch == 1;
                        clicked => {
                            root.haptic();
                            root.latch-key(1);
                        }
                    }
                    KeyChip {
                        text: "Alt";
                        latchable: true;
                        latched: root.latch == 2;
                        clicked => {
                            root.haptic();
                            root.latch-key(2);
                        }
                    }
                    for k in root.first-keys: KeyChip {
                        text: k.label;
                        dim: (root.latch == 1 && !k.ctrl) || (root.latch == 2 && !k.alt);
                        clicked => {
                            root.haptic();
                            root.key(k.key);
                        }
                    }
                    // Coller, Copier, Saisie masquée, A− et A+ ne prennent pas Ctrl ou Alt collé : ils le relâchent.
                    KeyChip {
                        text: "Coller";
                        dim: root.latch != 0;
                        clicked => {
                            root.haptic();
                            root.paste-clipboard();
                        }
                    }
                    KeyChip {
                        text: "Copier";
                        dim: root.latch != 0;
                        clicked => {
                            root.haptic();
                            root.copy(-1);
                        }
                    }
                    KeyChip {
                        text: "Saisie masquée";
                        latchable: true;
                        latched: root.masked;
                        dim: root.latch != 0;
                        clicked => {
                            root.haptic();
                            root.unlatch();
                            root.masked = !root.masked;
                            input.focus();
                        }
                    }
                    for k in root.more-keys: KeyChip {
                        text: k.label;
                        dim: (root.latch == 1 && !k.ctrl) || (root.latch == 2 && !k.alt);
                        clicked => {
                            root.haptic();
                            root.key(k.key);
                        }
                    }
                    KeyChip {
                        text: "A−";
                        dim: root.latch != 0;
                        clicked => {
                            root.unlatch();
                            root.set-zoom(root.zoom / 1.15);
                            root.zoomed(root.zoom);
                        }
                    }
                    KeyChip {
                        text: "A+";
                        dim: root.latch != 0;
                        clicked => {
                            root.unlatch();
                            root.set-zoom(root.zoom * 1.15);
                            root.zoomed(root.zoom);
                        }
                    }
                }
            }
            // Le champ qui reçoit la touche suivante quand Ctrl ou Alt est collé : invisible, et sans suggestions du
            // clavier (un champ de mot de passe), pour que chaque lettre arrive aussitôt tapée.
            catcher := TextInput {
                x: 0;
                y: 0;
                width: 1px;
                height: 1px;
                color: transparent;
                text-cursor-width: 0;
                input-type: password;
                single-line: true;
                enabled: root.can-type && !root.ended;
                accessible-label: "Touche suivante";
                edited => {
                    root.typed(self.text);
                    self.text = "";
                }
                // Les touches que le clavier envoie comme touches (Effacer dans un champ vide, Entrée).
                key-pressed(e) => {
                    if e.text == Key.Return {
                        root.key("enter");
                        return accept;
                    }
                    if e.text == Key.Backspace {
                        root.key("backspace");
                        return accept;
                    }
                    reject
                }
            }
            clip := TextInput {
                visible: false;
                single-line: false;
            }
        }

        // La dictée en cours : ce qui est entendu, au-dessus du champ, avant d'y être ajouté.
        listen-bar := Rectangle {
            height: root.listening ? listen.preferred-height + 12px : 0;
            visible: root.listening;
            background: Theme.surface;
            listen := ListenLine {
                x: 18px;
                y: 8px;
                width: parent.width - 36px;
                stopping: root.dictation-stopping;
                heard: root.heard;
                // Espace fine insécable (\u{202f}) avant « : », comme `view::tied`.
                hint: root.sends ? "Parlez\u{202f}: le texte partira au terminal, avec Entrée." : "Parlez, puis touchez le micro rouge\u{202f}: le texte s'ajoute à la saisie.";
            }
        }

        Rectangle {
            height: root.input-h + 16px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 21px;
                    background: Theme.surface-2;
                    border-width: input.has-focus ? 1.5px : 0;
                    border-color: Theme.accent;
                    clip: true;
                    field := Flickable {
                        x: 16px;
                        width: parent.width - 28px;
                        interactive: self.content-height > self.height + 1px;
                        content-width: self.width;
                        content-height: max(self.height, input.preferred-height + 20px);
                        input := TextInput {
                            y: 10px;
                            width: field.width;
                            height: max(field.height - 20px, self.preferred-height);
                            vertical-alignment: center;
                            text <=> root.draft;
                            enabled: root.can-type && !root.ended;
                            input-type: root.masked ? InputType.password : InputType.text;
                            color: Theme.text;
                            font-size: 15px;
                            single-line: false;
                            wrap: word-wrap;
                            // Des commandes, pas des phrases : ni majuscule ni correction automatiques.
                            input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false };
                            accessible-label: "Saisie pour le terminal";
                            key-pressed(e) => {
                                if e.text == Key.Return {
                                    if e.modifiers.shift {
                                        root.shift-return = true;
                                        return reject;
                                    }
                                    root.send-line(self.text);
                                    return accept;
                                }
                                reject
                            }
                            edited => {
                                if !root.shift-return && self.text == root.last-draft + "\n" {
                                    self.text = root.last-draft;
                                    root.send-line(self.text);
                                }
                                root.shift-return = false;
                                root.last-draft = self.text;
                            }
                            // Le curseur reste visible quand le texte dépasse le champ.
                            cursor-position-changed(p) => {
                                if p.y + 10px + field.content-y < 0 {
                                    field.content-y = min(0px, -p.y);
                                } else if p.y + 40px + field.content-y > field.height {
                                    field.content-y = max(field.height - field.content-height, field.height - p.y - 40px);
                                }
                            }
                        }
                    }
                    if root.draft == "": Text {
                        x: 16px;
                        width: parent.width - 28px;
                        text: root.ended ? "Terminal arrêté" : !root.can-type ? "Saisie non autorisée sur ce PC" : root.masked ? "Saisie masquée…" : "Écrire dans le terminal…";
                        color: Theme.text-faint;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                        height: parent.height;
                    }
                }
                if root.can-dictate && root.can-type && !root.ended && !root.masked: VerticalLayout {
                    alignment: end;
                    MicButton {
                        listening: root.listening;
                        stopping: root.dictation-stopping;
                        level: root.level;
                        clicked => { root.dictate(); }
                    }
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: send-ta.pressed ? Theme.accent.darker(0.2) : Theme.accent;
                        opacity: root.can-type && !root.ended ? 1 : 0.4;
                        accessible-role: button;
                        accessible-label: "Envoyer";
                        accessible-action-default => { root.send-line(input.text); }
                        Icon {
                            kind: "send";
                            tint: Theme.on-accent;
                            size: 20px;
                        }
                        send-ta := TouchArea {
                            enabled: root.can-type && !root.ended;
                            clicked => {
                                root.haptic();
                                root.send-line(input.text);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.copy-visible: CopySheet {
        width: parent.width;
        height: parent.height;
        text: root.copy-text;
        anchor: root.copy-anchor;
        focus-at: root.copy-focus;
        close => {
            root.copy-visible = false;
        }
        copied(all) => {
            root.copy-visible = false;
            root.copied(all);
        }
    }
}
