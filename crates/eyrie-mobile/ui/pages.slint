// Les pages de l'application connectée : vue d'ensemble, écran d'un module, « Plus », notifications, commandes du
// PC, réglages.

import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TailnetStatus } from "onboarding.slint";
import {
    UiAct, UiRow, TabItem, ScreenTabs, ModuleItem, WaitItem, NoteItem, CommandItem, PcItem, Icon, IconButton, ModuleAvatar, Pill,
    SectionHeader, RowView, NoteView, MeterView, TextBlock, ActButton, EmptyView, DiffLineView, BandHeader, SearchField
} from "widgets.slint";

// L'écran d'un module : les blocs décrits par le PC.
export component ScreenPage inherits Rectangle {
    in property <[UiRow]> rows;
    in property <bool> loading;
    in property <string> missing;
    // La position de la liste (négative : défilée) ; celle à rendre (`want-seq` change à chaque demande).
    in-out property <length> scroll-y <=> list.content-y;
    in property <length> want-y;
    in property <int> want-seq;
    // Le texte d'invite de la recherche (vide : pas de champ) et le texte cherché.
    in property <string> search-hint;
    in-out property <string> search-text;
    in property <[TabItem]> tabs;
    callback search-edited(string);
    callback select-tab(string);
    callback open-path(string);
    callback act(UiAct);
    callback menu(UiRow);
    callback fold(string);
    callback haptic();

    property <length> applied-y;
    property <int> settle;

    // La hauteur de la liste n'est connue qu'après la mise en page des lignes : la position est rendue de nouveau
    // quelques fois, tant que l'utilisateur n'a pas fait défiler la liste lui-même.
    function apply-scroll() {
        root.applied-y = max(min(0px, list.visible-height - list.content-height), min(0px, root.want-y));
        list.content-y = root.applied-y;
    }
    changed want-seq => {
        root.settle = 6;
        root.apply-scroll();
    }
    init => {
        root.settle = 6;
        root.apply-scroll();
    }
    Timer {
        interval: 50ms;
        running: root.settle > 0;
        triggered => {
            root.settle -= 1;
            if list.content-y == root.applied-y {
                root.apply-scroll();
            } else {
                root.settle = 0;
            }
        }
    }

    VerticalLayout {
        if root.tabs.length > 0: ScreenTabs {
            tabs: root.tabs;
            selected(p) => { root.select-tab(p); }
        }
        if root.search-hint != "": SearchField {
            hint: root.search-hint;
            text <=> root.search-text;
            edited(t) => { root.search-edited(t); }
        }
        list := ListView {
            for r in root.rows: VerticalLayout {
                if r.kind == 0: SectionHeader {
                    title: r.title;
                    aside: r.detail;
                }
                if r.kind == 8: BandHeader {
                    item: r;
                    toggle => {
                        root.haptic();
                        root.fold(r.key);
                    }
                    menu => { root.menu(r); }
                }
                if r.kind == 1: RowView {
                    item: r;
                    tapped => {
                        if r.opens {
                            root.open-path(r.path);
                        } else if r.has-tap {
                            if !r.tap.busy {
                                root.act(r.tap);
                            }
                        } else if r.acts.length > 0 {
                            root.menu(r);
                        }
                    }
                    menu => { root.menu(r); }
                    haptic => { root.haptic(); }
                }
                if r.kind == 2: NoteView {
                    text: r.title;
                    tone: r.tone;
                }
                if r.kind == 3: MeterView {
                    label: r.title;
                    value-text: r.detail;
                    value: r.value;
                    tone: r.tone;
                }
                if r.kind == 4: TextBlock {
                    text: r.title;
                    mono: r.mono;
                }
                if r.kind == 5: EmptyView {
                    text: r.title;
                }
                if r.kind == 7: DiffLineView {
                    text: r.title;
                    kind: r.tone;
                    first: r.first;
                    last: r.last;
                }
                // Les boutons passent à la ligne quand ils ne tiennent pas dans la largeur (donnée explicitement : dans
                // une ligne de liste, la mise en page ne la transmet pas et la hauteur serait devinée).
                if r.kind == 6: Rectangle {
                    height: flow.preferred-height;
                    flow := FlexboxLayout {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        for a in r.acts: ActButton {
                            text: a.label;
                            glyph: a.glyph;
                            style: a.style;
                            busy: a.busy;
                            clicked => { root.act(a); }
                        }
                    }
                }
            }
        }
    }
    if root.loading && root.rows.length == 0: Text {
        text: "Chargement…";
        color: Theme.text-faint;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.missing != "": Text {
        text: root.missing;
        color: Theme.text-faint;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 48px;
    }
}

component ModuleCard inherits Rectangle {
    in property <ModuleItem> module;
    callback clicked();
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.pressed : Theme.surface;
    animate background { duration: 90ms; }
    opacity: module.running ? 1 : 0.55;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            ModuleAvatar {
                module: root.module;
                size: 34px;
            }
            Rectangle { }
            Pill {
                text: root.module.badge;
                tone: root.module.badge-tone;
            }
        }
        Text {
            text: root.module.name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.module.running ? (root.module.status != "" ? root.module.status : root.module.summary) : root.module.status;
            color: Theme.text-dim;
            font-size: 12px;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component OverviewPage inherits Rectangle {
    in property <string> pc-name;
    in property <string> link-text;
    in property <int> link-tone;
    in property <[WaitItem]> waiting;
    in property <[ModuleItem]> modules;
    in property <[NoteItem]> notes;
    in property <int> unread;
    callback open-module(string);
    callback open-wait(string, string);
    callback open-notes();
    property <length> card-w: (root.width - 3 * Theme.pad) / 2;
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding-bottom: 24px;
            alignment: start;
            // Le PC.
            Rectangle {
                height: 84px;
                Rectangle {
                    x: Theme.pad;
                    y: 8px;
                    width: parent.width - 2 * Theme.pad;
                    height: 72px;
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 14px;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 12px;
                            background: Theme.accent-soft;
                            Icon {
                                kind: "pc";
                                tint: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: root.pc-name;
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.tone(root.link-tone);
                                }
                                Text {
                                    text: root.link-text;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
            SectionHeader {
                title: "CE QUI ATTEND";
                aside: root.waiting.length > 0 ? "\{root.waiting.length}" : "";
            }
            if root.waiting.length == 0: Rectangle {
                height: 56px;
                Rectangle {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 10px;
                        Icon {
                            kind: "check";
                            tint: Theme.ok;
                            size: 20px;
                        }
                        Text {
                            text: "Rien ne vous attend.";
                            color: Theme.text-dim;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            for w[i] in root.waiting: RowView {
                item: {
                    kind: 1,
                    title: w.text,
                    subtitle: w.module-name,
                    glyph: w.glyph,
                    color: w.color,
                    has-color: true,
                    tone: 3,
                    opens: true,
                    first: i == 0,
                    last: i == root.waiting.length - 1,
                };
                tapped => { root.open-wait(w.module, w.path); }
            }
            SectionHeader {
                title: "MODULES";
            }
            Rectangle {
                height: ceil(root.modules.length / 2) * (104px + 12px);
                for m[i] in root.modules: ModuleCard {
                    module: m;
                    x: Theme.pad + mod(i, 2) * (root.card-w + Theme.pad);
                    y: floor(i / 2) * (104px + 12px);
                    width: root.card-w;
                    height: 104px;
                    clicked => { root.open-module(m.id); }
                }
            }
            if root.notes.length > 0: SectionHeader {
                title: "NOTIFICATIONS";
                aside: root.unread > 0 ? "\{root.unread} non lue(s)" : "";
            }
            for n[i] in root.notes: RowView {
                item: {
                    kind: 1,
                    title: n.title,
                    subtitle: n.module-name + (n.body != "" ? " · " + n.body : ""),
                    detail: n.when,
                    glyph: n.read ? "·" : "●",
                    tone: n.read ? 0 : n.tone,
                    opens: true,
                    first: i == 0,
                    last: i == root.notes.length - 1,
                };
                tapped => { root.open-notes(); }
            }
        }
    }
}

export component MorePage inherits Rectangle {
    in property <[ModuleItem]> modules;
    in property <int> unread;
    in property <int> commands;
    callback open-module(string);
    callback toggle-pin(string);
    callback open(string);
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            alignment: start;
            padding-bottom: 24px;
            SectionHeader {
                title: "TOUS LES MODULES";
                aside: "★ : dans la barre du bas";
            }
            for m[i] in root.modules: Rectangle {
                height: 64px;
                Rectangle {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    background: ta.pressed ? Theme.pressed : Theme.surface;
                    border-top-left-radius: i == 0 ? Theme.radius : 0;
                    border-top-right-radius: i == 0 ? Theme.radius : 0;
                    border-bottom-left-radius: i == root.modules.length - 1 ? Theme.radius : 0;
                    border-bottom-right-radius: i == root.modules.length - 1 ? Theme.radius : 0;
                    ta := TouchArea {
                        clicked => { root.open-module(m.id); }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 4px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            ModuleAvatar {
                                module: m;
                                size: 36px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: m.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 500;
                                }
                                Pill {
                                    text: m.badge;
                                    tone: m.badge-tone;
                                }
                                Rectangle { }
                            }
                            Text {
                                text: m.running ? (m.status != "" ? m.status : m.summary) : m.status;
                                color: Theme.text-dim;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: m.pinned ? "star" : "star-outline";
                                label: m.pinned ? "Retirer de la barre du bas" : "Mettre dans la barre du bas";
                                tint: m.pinned ? Theme.warn : Theme.text-faint;
                                clicked => { root.toggle-pin(m.id); }
                            }
                        }
                    }
                    if i < root.modules.length - 1: Rectangle {
                        x: 62px;
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width - 62px;
                        background: Theme.border;
                    }
                }
            }
            SectionHeader {
                title: "ET AUSSI";
            }
            for e[i] in [
                { kind: 1, title: "Notifications", subtitle: "Le centre de notifications du PC", glyph: "●", opens: true, path: "notes", first: true, last: false },
                { kind: 1, title: "Commandes du PC", subtitle: "La palette des modules, exécutée sur le PC", glyph: "▶", opens: true, path: "commandes", first: false, last: false },
                { kind: 1, title: "Réglages", subtitle: "PC appairés, apparence, à propos", glyph: "⚙", opens: true, path: "reglages", first: false, last: true },
            ]: RowView {
                item: {
                    kind: e.kind,
                    title: e.title,
                    subtitle: e.subtitle,
                    glyph: e.glyph,
                    opens: true,
                    path: e.path,
                    first: e.first,
                    last: e.last,
                    badge: e.path == "notes" && root.unread > 0 ? "\{root.unread}" : "",
                    tone: 0,
                };
                tapped => { root.open(e.path); }
            }
        }
    }
}

export component NotesPage inherits Rectangle {
    in property <[NoteItem]> notes;
    ListView {
        for n[i] in root.notes: VerticalLayout {
            padding-top: i == 0 ? 8px : 0;
            RowView {
                item: {
                    kind: 1,
                    title: n.title,
                    subtitle: n.module-name + (n.body != "" ? " · " + n.body : ""),
                    detail: n.when,
                    glyph: n.read ? "·" : "●",
                    tone: n.read ? 0 : n.tone,
                    first: i == 0,
                    last: i == root.notes.length - 1,
                };
            }
        }
    }
    if root.notes.length == 0: EmptyView {
        text: "Aucune notification.";
    }
}

export component CommandsPage inherits Rectangle {
    in property <[CommandItem]> commands;
    in-out property <string> filter;
    callback run(CommandItem);
    callback filter-edited(string);
    VerticalLayout {
        SearchField {
            hint: "Chercher une commande";
            text <=> root.filter;
            edited(t) => { root.filter-edited(t); }
        }
        Text {
            text: "Elles s'exécutent dans Eyrie, sur le PC.";
            color: Theme.text-faint;
            font-size: 12.5px;
            horizontal-alignment: center;
            height: 22px;
        }
        ListView {
            for c[i] in root.commands: RowView {
                item: {
                    kind: 1,
                    title: c.title,
                    subtitle: c.module-name,
                    glyph: "▶",
                    first: i == 0,
                    last: i == root.commands.length - 1,
                };
                tapped => { root.run(c); }
            }
        }
        if root.commands.length == 0: EmptyView {
            text: root.filter == "" ? "Aucune commande." : "Aucune commande ne correspond.";
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback selected(int);
    height: 40px;
    border-radius: 20px;
    background: Theme.surface-2;
    HorizontalLayout {
        padding: 3px;
        for o[i] in root.options: Rectangle {
            border-radius: 17px;
            background: i == root.current ? Theme.surface : transparent;
            drop-shadow-blur: i == root.current ? 4px : 0;
            drop-shadow-color: #00000022;
            animate background { duration: 120ms; }
            Text {
                text: o;
                color: i == root.current ? Theme.text : Theme.text-dim;
                font-size: 14px;
                font-weight: i == root.current ? 600 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.selected(i); }
            }
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 52px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component Card inherits Rectangle {
    border-radius: Theme.radius;
    background: Theme.surface;
}

export component SettingsPage inherits Rectangle {
    in property <string> pc-name;
    in property <string> pc-host;
    in property <string> link-text;
    in property <string> eyrie-version;
    in property <string> rights-text;
    in property <string> app-version;
    in property <string> fingerprint;
    in property <[PcItem]> pcs;
    in-out property <string> device-name;
    in property <int> theme-choice;
    in property <int> text-size;
    in property <int> tailnet-state;
    in property <string> tailnet-text;
    callback set-theme(int);
    callback set-text-size(int);
    callback rename-device(string);
    callback switch-pc(string);
    callback pair-another();
    callback forget-pc();
    callback tailnet-login();
    callback tailnet-logout();
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            alignment: start;
            padding-bottom: 32px;
            spacing: 0;
            SectionHeader {
                title: "CE PC";
            }
            Rectangle {
                height: pc-col.preferred-height;
                Card {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    pc-col := VerticalLayout {
                        SettingRow {
                            label: "Nom";
                            value: root.pc-name;
                        }
                        SettingRow {
                            label: "Sur Tailscale";
                            value: root.pc-host;
                        }
                        SettingRow {
                            label: "État";
                            value: root.link-text;
                        }
                        SettingRow {
                            label: "Eyrie";
                            value: root.eyrie-version;
                        }
                        SettingRow {
                            label: "Droits";
                            value: root.rights-text;
                        }
                    }
                }
            }
            if root.pcs.length > 1: SectionHeader {
                title: "AUTRES PC";
            }
            for p[i] in root.pcs: VerticalLayout {
                if !p.current: RowView {
                    item: {
                        kind: 1,
                        title: p.name,
                        subtitle: p.host,
                        glyph: "▣",
                        opens: true,
                        first: true,
                        last: true,
                    };
                    tapped => { root.switch-pc(p.id); }
                }
            }
            HorizontalLayout {
                padding: Theme.pad;
                spacing: 10px;
                ActButton {
                    text: "Appairer un autre PC";
                    clicked => { root.pair-another(); }
                }
                ActButton {
                    text: "Oublier ce PC";
                    style: 2;
                    clicked => { root.forget-pc(); }
                }
            }
            SectionHeader {
                title: "CET APPAREIL";
            }
            Rectangle {
                height: 56px;
                Card {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text {
                            text: "Nom";
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                        name-input := TextInput {
                            text <=> root.device-name;
                            color: Theme.text-dim;
                            font-size: 15px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.rename-device(self.text); }
                        }
                    }
                }
            }
            Text {
                x: Theme.pad + 4px;
                text: "Empreinte : " + root.fingerprint + " · le nom vaut pour les prochains appairages.";
                color: Theme.text-faint;
                font-size: 12px;
                height: 28px;
                vertical-alignment: center;
            }
            // Le nœud Tailscale de l'application (Android) : le téléphone est lui-même sur le tailnet.
            if root.tailnet-state != 0: SectionHeader {
                title: "TAILSCALE";
            }
            if root.tailnet-state != 0: HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                TailnetStatus {
                    state: root.tailnet-state;
                    text: root.tailnet-text;
                    login => { root.tailnet-login(); }
                }
            }
            if root.tailnet-state == 3: HorizontalLayout {
                padding: Theme.pad;
                ActButton {
                    text: "Se déconnecter de Tailscale";
                    style: 2;
                    clicked => { root.tailnet-logout(); }
                }
            }
            SectionHeader {
                title: "APPARENCE";
            }
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                Segmented {
                    options: ["Comme le téléphone", "Clair", "Sombre"];
                    current: root.theme-choice;
                    selected(i) => { root.set-theme(i); }
                }
            }
            SectionHeader {
                title: "TEXTE DU TERMINAL";
            }
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                Segmented {
                    options: ["Ajusté", "Plus grand", "Très grand"];
                    current: root.text-size;
                    selected(i) => { root.set-text-size(i); }
                }
            }
            SectionHeader {
                title: "À PROPOS";
            }
            Rectangle {
                height: about-col.preferred-height;
                Card {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    about-col := VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Eyrie mobile " + root.app-version;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Tout ce que fait l'application se fait sur le PC, par Tailscale, dans un canal chiffré (Noise) entre ce téléphone et le PC appairé.";
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Interface faite avec Slint (slint.dev, licence libre de redevances). Police du terminal : Hack (MIT, Bitstream Vera).";
                            color: Theme.text-faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
