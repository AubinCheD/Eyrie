// La fenêtre de l'application : accueil et appairage, puis l'application connectée (barre du haut, un module à la
// fois, barre du bas), et ce qui passe par-dessus (feuilles d'actions, confirmations, saisies, bulles).

import "fonts/Hack-Regular.ttf";
import { Theme } from "theme.slint";
import {
    UiAct, UiRow, UiChip, GraphSeg, TabItem, ModuleItem, WaitItem, NoteItem, CommandItem, PcItem, NavItem, TopBar,
    BottomNav, ActionSheet, ConfirmDialog, Toast, ActButton, Icon, Busy
} from "widgets.slint";
import { ScreenPage, OverviewPage, MorePage, NotesPage, CommandsPage, SettingsPage } from "pages.slint";
import { TermView, TermRow } from "term.slint";
import { Onboarding, CodeEntry, Pairing, Scanner } from "onboarding.slint";
import { FolderPicker, PickRow, PickCrumb, PickerState } from "picker.slint";

export { Theme, UiAct, UiRow, UiChip, GraphSeg, TabItem, ModuleItem, WaitItem, NoteItem, CommandItem, PcItem, NavItem, TermRow }
export { PickRow, PickCrumb, PickerState }
export { TermSeg } from "term.slint";

export component AppWindow inherits Window {
    title: "Eyrie";
    background: Theme.bg;
    preferred-width: 412px;
    preferred-height: 892px;
    default-font-size: 15px;
    forward-focus: focus;

    // --- Où l'on est ---
    // 0 accueil, 1 code saisi, 2 appairage, 3 lecteur de QR code, 4 application connectée.
    in property <int> page;
    // `ensemble`, l'identifiant d'un module, `plus`, `notes`, `commandes`, `reglages`.
    in property <string> tab: "ensemble";
    in property <string> screen-title: "Ensemble";
    in property <string> subtitle;
    in property <bool> can-back;
    // Les actions de l'écran : celles de la barre (icônes, ou une seule en clair), celles du menu ⋯.
    in property <[UiAct]> bar-acts;
    in property <[UiAct]> screen-acts;
    in property <bool> show-pc;
    in property <bool> terminal-mode;

    // --- Le lien avec le PC : 0 connexion, 1 en ligne, 2 hors ligne, 3 refusé ---
    in property <int> link-state;
    in property <string> link-text;
    in property <string> pc-name;
    // Hors ligne, ce que l'on sait du PC (voir `veilleur.rs`) : 0 rien de plus que `link-text`, 1 PC injoignable,
    // 2 Eyrie fermée, 3 Eyrie démarre, 4 accès coupé sur le PC ; « Démarrer Eyrie » possible (avec confirmation).
    in property <int> away;
    in property <string> away-title;
    in property <string> away-text;
    in property <string> away-error;
    in property <bool> can-start;

    // --- Données ---
    in property <[NavItem]> nav;
    in property <[ModuleItem]> modules;
    in property <[WaitItem]> waiting;
    in property <[NoteItem]> notes;
    in property <[NoteItem]> recent-notes;
    in property <int> unread;
    // Ce qui attend a été reçu du PC ; hors ligne, de quand datent les données montrées.
    in property <bool> waiting-known;
    in property <string> data-age;
    in property <[CommandItem]> commands;
    in-out property <string> command-filter;
    in property <[UiRow]> rows;
    in property <bool> loading;
    in property <string> missing;
    // La position de la liste de l'écran (lue par le code avant de changer d'écran) ; celle à rendre au retour.
    in-out property <length> screen-scroll;
    in property <length> scroll-want;
    in property <int> scroll-seq;
    // La recherche de l'écran (filtrée sur le téléphone) : texte d'invite (vide : pas de champ), texte cherché.
    in property <string> search-hint;
    in-out property <string> search-text;
    // Les onglets de l'écran (des écrans voisins du module, entre lesquels on passe sans empiler).
    in property <[TabItem]> tabs;

    // --- Terminal ---
    in property <[TermRow]> term-rows;
    in property <int> term-cols: 80;
    in property <int> term-cursor-row: -1;
    in property <int> term-cursor-col;
    in property <float> term-zoom: 1;
    in property <bool> term-ended;
    in property <bool> term-waiting;
    in property <[string]> term-replies;
    in property <bool> term-can-type: true;
    in-out property <string> term-draft;
    out property <bool> term-at-bottom: term.at-bottom;

    // --- Accueil et appairage ---
    in property <image> logo;
    in property <bool> can-scan;
    in property <bool> has-pc;
    in-out property <string> code-host;
    in-out property <string> code-code;
    in-out property <string> code-link;
    in property <string> code-error;
    in property <string> pairing-pc;
    in property <string> pairing-sas;
    in property <int> pairing-stage;
    in property <string> pairing-error;
    in property <image> scanner-frame;
    in property <string> scanner-hint: "Visez le QR code affiché par Eyrie, sur le PC.";
    // Le nœud Tailscale de l'application : 0 absent (bureau), 1 démarrage, 2 connexion à faire, 3 connecté, 4 erreur.
    in property <int> tailnet-state;
    in property <string> tailnet-text;

    // --- Réglages ---
    in property <string> pc-host;
    in property <string> eyrie-version;
    in property <string> rights-text;
    in property <string> app-version;
    in property <string> fingerprint;
    in property <[PcItem]> pcs;
    in-out property <string> device-name;
    in property <int> text-size;

    // --- Bulle ---
    // La bulle montrée (son temps est tenu par le code) ; une erreur touchée se déplie.
    in property <string> toast-text;
    in property <int> toast-tone;
    in property <bool> toast-visible;
    in property <bool> toast-expanded;

    // --- Le sélecteur de dossiers du PC (une action qui demande un dossier) ---
    in property <bool> picker-visible;
    in property <PickerState> picker;
    in property <[PickCrumb]> picker-crumbs;
    in property <[PickRow]> picker-rows;
    in-out property <string> picker-filter;

    // --- Vers le code ---
    callback nav-select(string);
    callback open-module-path(string, string);
    callback open-path(string);
    callback back-requested() -> bool;
    callback run-act(UiAct, string);
    callback fold-band(string);
    callback toggle-wrap();
    callback search-edited(string);
    callback select-tab(string);
    callback open-url(string);
    callback haptic();
    callback toggle-pin(string);
    callback open-extra(string);
    callback notes-read();
    callback toast-tapped();
    callback open-note(NoteItem);
    callback run-command(CommandItem);
    callback filter-edited(string);
    callback set-theme(int);
    callback set-text-size(int);
    callback rename-device(string);
    callback switch-pc(string);
    callback pair-another();
    callback forget-pc();
    callback retry-link();
    callback start-eyrie();
    callback tailnet-login();
    callback tailnet-logout();
    callback start-scan();
    callback enter-code();
    callback submit-code();
    callback cancel-pairing();
    callback retry-pairing();
    callback pairing-done();
    callback onboarding-back();
    callback term-send-line(string);
    callback term-key(string);
    callback term-reply(int);
    callback term-zoom-by(float);
    callback open-folder(UiAct);
    callback picker-go(string);
    callback picker-pick(string);
    callback picker-choose();
    callback picker-more();
    callback picker-retry();
    callback picker-hidden();
    callback picker-filter-edited(string);
    callback picker-close();

    public function term-scroll-to-end() {
        term.scroll-to-end();
    }

    // Le menu ⋯ de l'écran (démonstration, captures).
    public function open-screen-menu() {
        root.show-sheet(root.screen-title, root.screen-acts);
    }

    // Une saisie de dossier en champ de texte, quand le PC ne liste pas ses dossiers : `note` dit pourquoi.
    public function ask-input(a: UiAct, note: string) {
        root.pending = a;
        root.input-note = note;
        root.input-text = a.input-value;
        root.folder-input = true;
        root.input-visible = true;
    }

    // Le dossier est choisi : la confirmation de l'action s'il y en a une (avec le chemin), puis l'envoi.
    public function finish-act(a: UiAct, input: string) {
        if a.confirm != "" {
            root.pending = a;
            root.chosen = input;
            root.has-chosen = true;
            root.confirm-visible = true;
            return;
        }
        root.run-act(a, input);
    }

    // --- Ce qui passe par-dessus ---
    property <bool> sheet-visible;
    property <string> sheet-title;
    property <[UiAct]> sheet-acts;
    property <UiAct> pending;
    property <bool> confirm-visible;
    property <bool> forget-visible;
    property <bool> logout-visible;
    property <bool> start-visible;
    property <bool> input-visible;
    property <string> input-text;
    // Le champ de texte tient lieu de sélecteur de dossiers : la confirmation vient après, et `input-note` dit pourquoi.
    property <bool> folder-input;
    property <string> input-note;
    // La saisie déjà faite (un dossier choisi), envoyée avec l'action une fois confirmée.
    property <string> chosen;
    property <bool> has-chosen;

    property <bool> kb-visible: root.virtual-keyboard-size.width > 0px && root.virtual-keyboard-size.height > 0px;
    property <length> bottom-inset: root.kb-visible ? max(root.safe-area-insets.bottom, root.height - root.virtual-keyboard-position.y) : root.safe-area-insets.bottom;

    // Une action : lien local, sinon confirmation, saisie, puis envoi.
    function start-act(a: UiAct) {
        root.sheet-visible = false;
        if a.busy {
            return;
        }
        if a.url != "" {
            root.open-url(a.url);
            return;
        }
        if a.open != "" {
            root.open-path(a.open);
            return;
        }
        root.pending = a;
        // Un dossier du PC : le sélecteur d'abord, la confirmation (s'il y en a une) une fois le dossier choisi.
        if a.has-input && a.folder {
            root.open-folder(a);
            return;
        }
        if a.confirm != "" {
            root.confirm-visible = true;
            return;
        }
        if a.has-input {
            root.input-text = a.input-value;
            root.input-visible = true;
            return;
        }
        root.run-act(a, "");
    }

    // La saisie est faite (champ de texte) : l'action part, ou, si le champ tenait lieu de sélecteur, sa confirmation.
    function submit-input() {
        root.input-visible = false;
        if root.folder-input {
            root.folder-input = false;
            root.finish-act(root.pending, root.input-text);
            return;
        }
        root.run-act(root.pending, root.input-text);
    }

    function cancel-input() {
        root.input-visible = false;
        root.folder-input = false;
    }

    function show-sheet(title: string, acts: [UiAct]) {
        root.sheet-title = title;
        root.sheet-acts = acts;
        root.sheet-visible = true;
        root.haptic();
    }

    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Back || e.text == Key.Escape {
                if root.sheet-visible || root.confirm-visible || root.input-visible || root.forget-visible || root.logout-visible || root.start-visible {
                    root.sheet-visible = false;
                    root.confirm-visible = false;
                    root.has-chosen = false;
                    root.cancel-input();
                    root.forget-visible = false;
                    root.logout-visible = false;
                    root.start-visible = false;
                    return accept;
                }
                // Le sélecteur de dossiers se ferme (on remonte d'un dossier par le fil d'Ariane).
                if root.picker-visible {
                    root.picker-close();
                    return accept;
                }
                if root.back-requested() {
                    return accept;
                }
            }
            reject
        }

        Rectangle {
            x: root.safe-area-insets.left;
            y: root.safe-area-insets.top;
            width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
            height: root.height - root.safe-area-insets.top - root.bottom-inset;

            if root.page == 0: Onboarding {
                logo: root.logo;
                can-scan: root.can-scan;
                back-possible: root.has-pc;
                tailnet-state: root.tailnet-state;
                tailnet-text: root.tailnet-text;
                tailnet-login => { root.tailnet-login(); }
                scan => { root.start-scan(); }
                enter-code => { root.enter-code(); }
                back => { root.onboarding-back(); }
            }
            if root.page == 1: CodeEntry {
                host <=> root.code-host;
                code <=> root.code-code;
                link <=> root.code-link;
                error: root.code-error;
                submit => { root.submit-code(); }
                cancel => { root.cancel-pairing(); }
            }
            if root.page == 2: Pairing {
                pc: root.pairing-pc;
                sas: root.pairing-sas;
                stage: root.pairing-stage;
                error: root.pairing-error;
                cancel => { root.cancel-pairing(); }
                retry => { root.retry-pairing(); }
                done => { root.pairing-done(); }
            }
            if root.page == 3: Scanner {
                frame: root.scanner-frame;
                hint: root.scanner-hint;
                cancel => { root.cancel-pairing(); }
                enter-code => { root.enter-code(); }
            }
            VerticalLayout {
                visible: root.page == 4;
                TopBar {
                    title: root.screen-title;
                    subtitle: root.subtitle;
                    can-back: root.can-back;
                    bar: root.bar-acts;
                    acts: root.screen-acts;
                    show-pc: root.show-pc;
                    pc => {
                        root.haptic();
                        root.run-act({ id: "@pc", label: "Montrer sur le PC" }, "");
                    }
                    back => { root.back-requested(); }
                    act(a) => { root.start-act(a); }
                    more => { root.show-sheet(root.screen-title, root.screen-acts); }
                }
                // Hors ligne : les dernières données restent, un bandeau le dit (Eyrie fermée : « Démarrer » ; elle
                // démarre : l'indicateur, la liaison réessaie d'elle-même).
                if root.link-state != 1: Rectangle {
                    height: 48px;
                    background: root.link-state == 3 ? Theme.danger.with-alpha(0.16) : Theme.warn.with-alpha(0.16);
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: 4px;
                        spacing: 4px;
                        Text {
                            text: root.link-text;
                            color: Theme.text;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.away == 3: VerticalLayout {
                            padding-right: 12px;
                            alignment: center;
                            Busy {
                                size: 18px;
                            }
                        }
                        // Toute la hauteur du bandeau se touche.
                        if root.link-state != 0 && root.away != 3: Rectangle {
                            width: retry-label.preferred-width + 24px;
                            accessible-role: button;
                            accessible-label: retry-label.text;
                            accessible-action-default => { retry-ta.clicked(); }
                            Rectangle {
                                y: 6px;
                                height: parent.height - 12px;
                                border-radius: self.height / 2;
                                background: retry-ta.pressed ? Theme.pressed : transparent;
                            }
                            retry-label := Text {
                                text: root.can-start ? "Démarrer" : "Réessayer";
                                color: Theme.accent;
                                font-size: 13.5px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            retry-ta := TouchArea {
                                clicked => {
                                    if root.can-start {
                                        root.start-visible = true;
                                    } else {
                                        root.retry-link();
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    if root.tab == "ensemble": OverviewPage {
                        pc-name: root.pc-name;
                        link-text: root.link-text;
                        link-tone: root.link-state == 1 ? 2 : root.link-state == 3 ? 4 : 3;
                        link-state: root.link-state;
                        waiting: root.waiting;
                        modules: root.modules;
                        notes: root.recent-notes;
                        unread: root.unread;
                        waiting-known: root.waiting-known;
                        data-age: root.data-age;
                        away: root.away;
                        away-title: root.away-title;
                        away-text: root.away-text;
                        away-error: root.away-error;
                        can-start: root.can-start;
                        start-eyrie => { root.start-visible = true; }
                        open-module(id) => { root.nav-select(id); }
                        open-wait(id, path) => { root.open-module-path(id, path); }
                        open-note(n) => { root.open-note(n); }
                        open-notes => { root.open-extra("notes"); }
                    }
                    if root.tab == "plus": MorePage {
                        modules: root.modules;
                        unread: root.unread;
                        open-module(id) => { root.nav-select(id); }
                        toggle-pin(id) => {
                            root.haptic();
                            root.toggle-pin(id);
                        }
                        open(what) => { root.open-extra(what); }
                    }
                    if root.tab == "notes": NotesPage {
                        notes: root.notes;
                        open-note(n) => { root.open-note(n); }
                    }
                    if root.tab == "commandes": CommandsPage {
                        commands: root.commands;
                        filter <=> root.command-filter;
                        run(c) => {
                            root.pending = { id: c.id, label: c.title, confirm: "Exécuter « " + c.title + " » sur le PC ?" };
                            root.confirm-visible = true;
                            root.selected-command = c;
                        }
                        filter-edited(t) => { root.filter-edited(t); }
                    }
                    if root.tab == "reglages": SettingsPage {
                        pc-name: root.pc-name;
                        pc-host: root.pc-host;
                        link-text: root.link-text;
                        eyrie-version: root.eyrie-version;
                        rights-text: root.rights-text;
                        app-version: root.app-version;
                        fingerprint: root.fingerprint;
                        pcs: root.pcs;
                        device-name <=> root.device-name;
                        theme-choice: Theme.choice;
                        text-size: root.text-size;
                        set-theme(i) => { root.set-theme(i); }
                        set-text-size(i) => { root.set-text-size(i); }
                        rename-device(n) => { root.rename-device(n); }
                        switch-pc(id) => { root.switch-pc(id); }
                        pair-another => { root.pair-another(); }
                        forget-pc => { root.forget-visible = true; }
                        tailnet-state: root.tailnet-state;
                        tailnet-text: root.tailnet-text;
                        tailnet-login => { root.tailnet-login(); }
                        tailnet-logout => { root.logout-visible = true; }
                    }
                    if !root.terminal-mode && root.tab != "ensemble" && root.tab != "plus" && root.tab != "notes" && root.tab != "commandes" && root.tab != "reglages": ScreenPage {
                        rows: root.rows;
                        loading: root.loading;
                        missing: root.missing;
                        scroll-y <=> root.screen-scroll;
                        want-y: root.scroll-want;
                        want-seq: root.scroll-seq;
                        search-hint: root.search-hint;
                        search-text <=> root.search-text;
                        search-edited(t) => { root.search-edited(t); }
                        tabs: root.tabs;
                        select-tab(p) => {
                            root.haptic();
                            root.select-tab(p);
                        }
                        open-path(p) => { root.open-path(p); }
                        act(a) => { root.start-act(a); }
                        menu(r) => { root.show-sheet(r.title, r.acts); }
                        fold(k) => { root.fold-band(k); }
                        toggle-wrap => { root.toggle-wrap(); }
                        haptic => { root.haptic(); }
                    }
                    term := TermView {
                        visible: root.terminal-mode;
                        rows: root.term-rows;
                        cols: root.term-cols;
                        cursor-row: root.term-cursor-row;
                        cursor-col: root.term-cursor-col;
                        zoom: root.term-zoom;
                        ended: root.term-ended;
                        waiting: root.term-waiting;
                        replies: root.term-replies;
                        can-type: root.term-can-type;
                        draft <=> root.term-draft;
                        send-line(t) => { root.term-send-line(t); }
                        key(k) => { root.term-key(k); }
                        reply(i) => { root.term-reply(i); }
                        zoom-by(f) => { root.term-zoom-by(f); }
                        haptic => { root.haptic(); }
                    }
                }
                if !root.kb-visible && !root.terminal-mode: BottomNav {
                    items: root.nav;
                    current: root.tab == "notes" || root.tab == "commandes" || root.tab == "reglages" ? "plus" : root.tab;
                    select(k) => {
                        root.haptic();
                        root.nav-select(k);
                    }
                }
            }
            // Par-dessus l'écran, sous les dialogues : les mises à jour du PC ne le ferment pas.
            if root.picker-visible && root.page == 4: FolderPicker {
                state: root.picker;
                crumbs: root.picker-crumbs;
                rows: root.picker-rows;
                filter <=> root.picker-filter;
                go(p) => { root.picker-go(p); }
                pick(p) => {
                    root.haptic();
                    root.picker-pick(p);
                }
                choose => {
                    root.haptic();
                    root.picker-choose();
                }
                more => { root.picker-more(); }
                retry => { root.picker-retry(); }
                toggle-hidden => { root.picker-hidden(); }
                filter-edited(t) => { root.picker-filter-edited(t); }
                close => { root.picker-close(); }
                haptic => { root.haptic(); }
            }
        }
    }

    property <CommandItem> selected-command;

    // --- Par-dessus ---
    if root.sheet-visible: ActionSheet {
        title: root.sheet-title;
        acts: root.sheet-acts;
        bottom-inset: root.safe-area-insets.bottom;
        chosen(a) => { root.start-act(a); }
        dismissed => { root.sheet-visible = false; }
    }
    if root.confirm-visible: ConfirmDialog {
        text: root.has-chosen ? root.pending.confirm + "\n\n" + root.chosen : root.pending.confirm;
        ok-text: root.pending.label != "" ? root.pending.label : "Confirmer";
        danger: root.pending.style == 2;
        answered(yes) => {
            root.confirm-visible = false;
            if !yes {
                root.has-chosen = false;
                return;
            }
            if root.has-chosen {
                root.has-chosen = false;
                root.run-act(root.pending, root.chosen);
                return;
            }
            if root.tab == "commandes" {
                root.run-command(root.selected-command);
                return;
            }
            if root.pending.has-input {
                root.input-text = root.pending.input-value;
                root.input-visible = true;
                return;
            }
            root.run-act(root.pending, "");
        }
    }
    if root.forget-visible: ConfirmDialog {
        text: "Oublier « " + root.pc-name + " » ? Il faudra l'appairer de nouveau pour le piloter.";
        ok-text: "Oublier";
        danger: true;
        answered(yes) => {
            root.forget-visible = false;
            if yes {
                root.forget-pc();
            }
        }
    }
    if root.start-visible: ConfirmDialog {
        text: "Démarrer Eyrie sur « " + root.pc-name + " » ?\n\nElle s'ouvrira réduite sur le PC ; ce téléphone s'y connecte dès qu'elle est prête.";
        ok-text: "Démarrer";
        answered(yes) => {
            root.start-visible = false;
            if yes {
                root.haptic();
                root.start-eyrie();
            }
        }
    }
    if root.logout-visible: ConfirmDialog {
        text: "Déconnecter ce téléphone de Tailscale ? Il ne joindra plus le PC avant de se reconnecter à votre compte.";
        ok-text: "Déconnecter";
        danger: true;
        answered(yes) => {
            root.logout-visible = false;
            if yes {
                root.tailnet-logout();
            }
        }
    }
    if root.input-visible: Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { root.cancel-input(); }
        }
        Rectangle {
            y: max(24px, (parent.height - root.bottom-inset - self.height) / 2);
            width: min(parent.width - 32px, 420px);
            height: input-col.preferred-height;
            border-radius: 22px;
            background: Theme.surface;
            TouchArea { }
            input-col := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text {
                    text: root.pending.input-label != "" ? root.pending.input-label : root.pending.label;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.input-note != "" && root.folder-input: Text {
                    text: root.input-note;
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: root.pending.multiline ? 120px : 48px;
                    border-radius: 12px;
                    background: Theme.surface-2;
                    border-width: field.has-focus ? 2px : 0;
                    border-color: Theme.accent;
                    field := TextInput {
                        x: 12px;
                        y: root.pending.multiline ? 10px : 0;
                        width: parent.width - 24px;
                        height: root.pending.multiline ? parent.height - 20px : parent.height;
                        text <=> root.input-text;
                        color: Theme.text;
                        font-size: 16px;
                        vertical-alignment: root.pending.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                        single-line: !root.pending.multiline;
                        wrap: root.pending.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
                        accepted => { root.submit-input(); }
                        init => { self.focus(); }
                    }
                    if root.input-text == "": Text {
                        x: 12px;
                        y: root.pending.multiline ? 10px : 0;
                        height: root.pending.multiline ? 24px : parent.height;
                        text: root.pending.input-placeholder;
                        color: Theme.text-faint;
                        font-size: 16px;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    ActButton {
                        text: "Annuler";
                        clicked => { root.cancel-input(); }
                    }
                    ActButton {
                        text: root.pending.label;
                        style: 1;
                        clicked => { root.submit-input(); }
                    }
                }
            }
        }
    }
    if root.toast-visible: Toast {
        x: 16px;
        width: parent.width - 32px;
        y: parent.height - root.bottom-inset - (root.terminal-mode ? 170px : 84px) - self.height;
        text: root.toast-text;
        tone: root.toast-tone;
        expanded: root.toast-expanded;
        max-text: parent.height * 0.6;
        tapped => { root.toast-tapped(); }
    }
}
