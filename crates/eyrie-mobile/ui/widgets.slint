// Les composants communs : données reçues du PC (lignes d'écran, actions, modules), icônes, lignes de liste,
// barres du haut et du bas, feuilles et dialogues.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

export { Icon }

// Une action (bouton, toucher d'une ligne, entrée d'un menu). `style` : 0 normal, 1 principal, 2 danger. `busy` : en
// cours (envoyée sans réponse du PC, ou déjà faite par le module) : grisée, avec un indicateur.
export struct UiAct {
    id: string,
    label: string,
    glyph: string,
    // L'icône Material qui tient lieu du glyphe dans la barre du haut (voir `Icon`) ; vide : le glyphe.
    icon: string,
    style: int,
    confirm: string,
    has-input: bool,
    input-label: string,
    input-placeholder: string,
    input-value: string,
    multiline: bool,
    url: string,
    // Action propre au téléphone : ouvrir ce sous-écran du module, ou celui d'un autre (« @module <id> [<chemin>] ») ;
    // rien n'est envoyé au PC.
    open: string,
    busy: bool,
    // La saisie est un dossier du PC : le sélecteur de dossiers plutôt qu'un champ de texte.
    folder: bool,
    // L'écran du module qui l'offre (vide : action du téléphone) : confirmée quand un autre est affiché, elle ne part
    // pas.
    module: string,
    path: string,
}

// Une étiquette d'une ligne (branche, étiquette git, HEAD) ; `strong` : mise en avant (pleine).
export struct UiChip {
    text: string,
    glyph: string,
    // L'icône Material du glyphe (vide : le glyphe en texte).
    icon: string,
    color: color,
    has-color: bool,
    tone: int,
    strong: bool,
}

// Un trait du graphe des commits dans une ligne : un chemin SVG (pixels de la cellule) et la couleur de sa voie.
export struct GraphSeg {
    d: string,
    lane: int,
}

// Une ligne d'écran. `kind` : 0 section, 1 ligne, 2 note, 3 jauge, 4 texte, 5 vide, 6 boutons, 7 ligne de diff (`tone` :
// 0 contexte, 1 ajout, 2 retrait, 3 en-tête ; `subtitle` et `detail` : ancien et nouveau numéro ; `gutter` : chiffres
// de la gouttière, 0 sans numéros), 8 bandeau (`key` : sa clé ; `fold` : 0 ne se plie pas, 1 ouvert, 2 plié, 3 ouvert
// le temps d'une recherche, sans se plier), 9 en-tête d'un diff (`title` : ajouts et retraits). `wrap` : les lignes des
// diffs passent à la ligne ; une ligne de liste montre son titre et son sous-titre en entier (`Row::full`).
export struct UiRow {
    kind: int,
    key: string,
    fold: int,
    title: string,
    subtitle: string,
    detail: string,
    glyph: string,
    // L'icône Material du glyphe (`view::icon_for`), sinon `mark` : une ou deux lettres (l'état d'un fichier) ; sans
    // l'une ni l'autre, un glyphe qui reste en texte, ou rien.
    icon: string,
    mark: string,
    // Le ton de `mark` (`view::mark_tone`) : 0 neutre, sinon celui de `Theme.tone`.
    mark-tone: int,
    // Une entrée non lue : titre en gras et point de couleur.
    unread: bool,
    color: color,
    has-color: bool,
    tone: int,
    badge: string,
    path: string,
    opens: bool,
    tap: UiAct,
    has-tap: bool,
    // Un bouton visible à droite, en plus du menu.
    trailing: UiAct,
    has-trailing: bool,
    acts: [UiAct],
    value: float,
    mono: bool,
    first: bool,
    last: bool,
    // Une action de la ligne (toucher ou menu) est en cours.
    busy: bool,
    // Barre de progression (ligne, note) : `value` de 0 à 1, ou indéterminée.
    has-progress: bool,
    indeterminate: bool,
    gutter: int,
    wrap: bool,
    chips: [UiChip],
    // Ligne de commit : largeur de la colonne du graphe, nœud (-1 aucun, 0 commit, 1 fusion, 2 HEAD, 3 perdu,
    // 4 remise), son abscisse et sa voie (couleur), les traits.
    graph: bool,
    graph-w: length,
    node: int,
    node-x: length,
    node-lane: int,
    segs: [GraphSeg],
}

// Un onglet d'écran : son chemin dans le module ; `active` : l'écran affiché.
export struct TabItem {
    label: string,
    path: string,
    badge: string,
    active: bool,
}

export struct ModuleItem {
    id: string,
    name: string,
    glyph: string,
    // L'icône Material du module (`view::module_icon`) ; vide : son logo, sinon son initiale.
    icon: string,
    color: color,
    logo: image,
    has-logo: bool,
    badge: string,
    badge-tone: int,
    status: string,
    running: bool,
    pinned: bool,
    summary: string,
}

export struct WaitItem {
    module: string,
    module-name: string,
    glyph: string,
    // L'icône Material du module (vide : `glyph`, son initiale).
    icon: string,
    color: color,
    text: string,
    // L'écran du module où y répondre (vide : son accueil).
    path: string,
}

// Une notification du PC ; `path` : l'écran du module où elle mène ; `expanded` : dépliée (texte entier).
export struct NoteItem {
    module: string,
    module-name: string,
    title: string,
    body: string,
    tone: int,
    when: string,
    read: bool,
    path: string,
    has-path: bool,
    expanded: bool,
    key: string,
}

export struct CommandItem {
    module: string,
    module-name: string,
    id: string,
    title: string,
}

export struct PcItem {
    id: string,
    name: string,
    host: string,
    current: bool,
}

// Une action en cours : un arc qui tourne.
export component Busy inherits Rectangle {
    in property <length> size: 20px;
    in property <color> tint: Theme.accent;
    width: size;
    height: size;
    accessible-role: progress-indicator;
    accessible-label: "En cours";
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2.2px;
        commands: "M 12 3 A 9 9 0 1 1 3 12";
        transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
    }
}

// Une barre de progression fine ; indéterminée : un segment qui file.
export component ThinProgress inherits Rectangle {
    in property <float> value;
    in property <bool> indeterminate;
    in property <color> tint: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: root.tint.with-alpha(0.18);
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: root.indeterminate ? "" : "\{round(root.value * 100)} %";
    if !root.indeterminate: Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        border-radius: 2px;
        background: root.tint;
        animate width { duration: 300ms; easing: ease-out; }
    }
    if root.indeterminate: Rectangle {
        width: parent.width * 0.3;
        x: mod(animation-tick() / 1ms, 1400) / 1400 * (parent.width + self.width) - self.width;
        border-radius: 2px;
        background: root.tint;
    }
}

// Un bouton rond, une icône dedans.
export component IconButton inherits Rectangle {
    in property <string> icon;
    // L'icône pleine (une étoile choisie).
    in property <bool> filled;
    // Ce que dit le lecteur d'écran.
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <length> size: 44px;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: ta.pressed ? Theme.pressed : transparent;
    animate background { duration: 120ms; }
    Icon {
        kind: root.icon;
        filled: root.filled;
        tint: root.tint;
        size: root.size >= 44px ? 24px : 22px;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Le micro de la dictée (voir `dictee.rs`) : un toucher écoute, un second finit, et le texte entendu s'ajoute à la
// saisie. Rouge pendant l'écoute, un halo suit le niveau du son (`level`, de 0 à 1) ; pâli tant que le micro ne s'est
// pas ouvert (`starting` : un toucher abandonne), et quand la fin est demandée, le temps que le texte final arrive.
export component MicButton inherits Rectangle {
    in property <bool> listening;
    in property <bool> starting;
    in property <bool> stopping;
    in property <float> level;
    callback clicked();
    width: 42px;
    height: 42px;
    accessible-role: button;
    accessible-label: root.starting ? "Annuler la dictée" : root.listening ? "Finir la dictée" : "Dicter";
    accessible-action-default => { root.clicked(); }
    if root.listening && !root.starting: Rectangle {
        width: root.width + 16px * root.level;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.danger.with-alpha(0.25);
        animate width { duration: 90ms; }
    }
    Rectangle {
        border-radius: root.width / 2;
        background: root.listening ? (ta.pressed ? Theme.danger.darker(0.2) : Theme.danger)
            : ta.pressed ? Theme.pressed : Theme.surface-2;
        opacity: root.starting || root.stopping ? 0.55 : 1;
        animate background { duration: 120ms; }
        Icon {
            kind: "mic";
            tint: root.listening ? Theme.on-accent : Theme.text;
            size: 22px;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// L'écoute de la dictée : « Un instant… » tant que le micro ne s'est pas ouvert (`starting` : ce qui serait dit déjà
// serait perdu), « J'écoute… », puis le texte provisoire, en italique (il n'est pas encore dans la saisie), dont on
// voit la fin sur `lines` lignes ; `hint` tant que rien n'est entendu.
export component ListenLine inherits Rectangle {
    in property <bool> starting;
    in property <bool> stopping;
    in property <string> heard;
    in property <string> hint;
    in property <int> lines: 2;
    height: col.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: (root.starting ? "Un instant" : root.stopping ? "Fin de la dictée" : "J'écoute")
        + (root.heard != "" ? " : " + root.heard : "");
    probe := Text {
        visible: false;
        text: root.lines >= 3 ? "X\nX\nX" : "X\nX";
        font-size: 14px;
    }
    col := VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.starting ? Theme.text-faint : Theme.danger;
                }
            }
            Text {
                text: root.starting ? "Un instant…" : root.stopping ? "Fin de la dictée…" : "J'écoute…";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: probe.preferred-height;
            clip: true;
            Text {
                y: min(0px, parent.height - self.height);
                width: parent.width;
                height: self.preferred-height;
                text: root.heard != "" ? root.heard : root.starting ? "" : root.hint;
                color: root.heard != "" ? Theme.text-dim : Theme.text-faint;
                font-size: 14px;
                font-italic: root.heard != "";
                wrap: word-wrap;
            }
        }
    }
}

// Un champ de recherche, filtré sur le téléphone : icône, texte d'invite, bouton pour effacer.
export component SearchField inherits Rectangle {
    in property <string> hint;
    in-out property <string> text;
    callback edited(string);
    height: 60px;
    Rectangle {
        x: Theme.pad;
        y: 8px;
        width: parent.width - 2 * Theme.pad;
        height: 44px;
        border-radius: 22px;
        background: Theme.surface;
        border-width: input.has-focus ? 2px : 0;
        border-color: Theme.accent;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 2px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    kind: "search";
                    tint: Theme.text-faint;
                    size: 20px;
                }
            }
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                horizontal-stretch: 1;
                accessible-placeholder-text: root.hint;
                edited => { root.edited(self.text); }
            }
            if root.text != "": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "close";
                    label: "Effacer la recherche";
                    size: 40px;
                    tint: Theme.text-dim;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
        if root.text == "": Text {
            x: 46px;
            height: parent.height;
            text: root.hint;
            color: Theme.text-faint;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
}

// Un bouton plein (`style` : 0 normal, 1 principal, 2 danger), avec le glyphe de l'action devant son libellé ;
// `busy` : l'action est en cours (indicateur à la place du glyphe, bouton inactif) ; `compact` : le glyphe seul dans
// un rond (s'il y en a un ; le libellé reste pour le lecteur d'écran).
export component ActButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    // L'icône Material (`UiAct.icon`) ; vide : le glyphe en texte.
    in property <string> icon;
    in property <int> style: 0;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <bool> compact;
    // Marge de part et d'autre du libellé (plus serrée dans une ligne).
    in property <length> pad: 16px;
    callback clicked();
    property <color> ink: root.style == 1 ? Theme.on-accent : root.style == 2 ? Theme.danger : Theme.accent-ink;
    property <bool> has-mark: root.icon != "" || root.glyph != "";
    property <bool> round: root.compact && root.has-mark;
    height: 40px;
    preferred-width: root.round ? self.height : content.preferred-width;
    border-radius: self.height / 2;
    opacity: !enabled ? 0.45 : busy ? 0.7 : 1;
    background: style == 1 ? (ta.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : style == 2 ? (ta.pressed ? Theme.danger.with-alpha(0.25) : Theme.danger.with-alpha(0.12))
        : (ta.pressed ? Theme.accent.with-alpha(0.22) : Theme.accent-soft);
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.busy ? root.text + " (en cours)" : root.text;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => { root.clicked(); }
    content := HorizontalLayout {
        padding-left: root.round ? 0 : root.has-mark ? root.pad - 4px : root.pad;
        padding-right: root.round ? 0 : root.pad;
        spacing: 8px;
        alignment: center;
        if root.busy: VerticalLayout {
            alignment: center;
            Busy {
                size: 18px;
                tint: root.ink;
            }
        }
        if !root.busy && root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                kind: root.icon;
                tint: root.ink;
                size: 18px;
            }
        }
        if !root.busy && root.icon == "" && root.glyph != "": Text {
            text: root.glyph;
            color: root.ink;
            font-size: root.round ? 18px : 15px;
            vertical-alignment: center;
        }
        if !root.round: Text {
            text: root.text;
            color: root.ink;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled && !root.busy;
        clicked => { root.clicked(); }
    }
}

// Le signe d'un module : son icône Material sur sa couleur, sinon son logo, sinon son initiale. `original` : le signe
// d'origine du module, son logo (envoyé par le PC) ou son initiale sur sa couleur, jamais l'icône Material (la barre du
// bas, au choix de l'utilisateur). `bare` : l'icône seule, pleine quand `filled`.
export component ModuleAvatar inherits Rectangle {
    in property <ModuleItem> module;
    in property <length> size: 36px;
    in property <bool> original;
    in property <bool> bare;
    in property <bool> filled;
    in property <color> tint: module.color;
    property <string> icon: root.original ? "" : module.icon;
    width: size;
    height: size;
    border-radius: size * (root.original ? 0.28 : 0.3);
    background: root.bare || (root.icon == "" && module.has-logo) ? transparent
        : module.color.with-alpha(root.original ? 0.18 : 0.16);
    if root.icon != "": Icon {
        kind: root.icon;
        filled: root.filled;
        tint: root.tint;
        size: root.bare ? root.size : root.size * 0.6;
    }
    if root.icon == "" && module.has-logo: Image {
        source: module.logo;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if root.icon == "" && !module.has-logo: Text {
        text: module.glyph;
        font-size: root.size * 0.48;
        font-weight: 700;
        color: module.color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Une pastille (compteur, « attend ») : pleine, ou douce (`soft` : fond pâle, texte du ton) dans une ligne.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <int> tone: 3;
    in property <bool> soft;
    visible: text != "";
    height: 20px;
    width: max(20px, label.preferred-width + (root.soft ? 14px : 12px));
    border-radius: 10px;
    background: root.soft ? Theme.tone(tone).with-alpha(Theme.dark ? 0.22 : 0.13) : Theme.tone(tone);
    // Texte foncé sur les pastilles pleines du thème sombre (le blanc y manque de contraste).
    label := Text {
        text: root.text;
        color: root.soft ? Theme.tone-ink(tone) : Theme.dark ? #121316 : #ffffff;
        font-size: 11.5px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Les onglets d'un écran, sous la barre du haut : onglets Material, soulignés, de largeur égale quand ils tiennent,
// sinon une rangée qui défile de côté.
export component ScreenTabs inherits Rectangle {
    in property <[TabItem]> tabs;
    callback selected(string);
    height: 46px;
    accessible-role: tab-list;
    Flickable {
        interactive: strip.min-width > root.width;
        content-width: max(self.width, strip.min-width);
        strip := HorizontalLayout {
            width: max(root.width, self.min-width);
            for t in root.tabs: Rectangle {
                horizontal-stretch: 1;
                min-width: content.preferred-width;
                accessible-role: tab;
                accessible-label: t.badge != "" ? t.label + ", " + t.badge : t.label;
                accessible-item-selected: t.active;
                accessible-action-default => { root.selected(t.path); }
                background: ta.pressed ? Theme.pressed : transparent;
                animate background { duration: 120ms; }
                content := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: t.label;
                        color: t.active ? Theme.accent-ink : Theme.text-dim;
                        font-size: 14px;
                        font-weight: t.active ? 700 : 500;
                        vertical-alignment: center;
                    }
                    if t.badge != "": VerticalLayout {
                        alignment: center;
                        Pill {
                            text: t.badge;
                            tone: 1;
                            soft: !t.active;
                        }
                    }
                }
                // L'indicateur sous l'onglet actif, de la largeur de son libellé.
                if t.active: Rectangle {
                    y: parent.height - 3px;
                    height: 3px;
                    width: max(28px, content.preferred-width - 16px);
                    border-top-left-radius: 3px;
                    border-top-right-radius: 3px;
                    background: Theme.accent;
                }
                ta := TouchArea {
                    clicked => { root.selected(t.path); }
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> aside;
    height: 44px;
    HorizontalLayout {
        padding-left: Theme.pad + 4px;
        padding-right: Theme.pad + 4px;
        padding-top: 16px;
        Text {
            text: root.title;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.aside;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Une étiquette : contour de sa couleur, pleine si elle est mise en avant. À l'étroit, elle garde son glyphe et
// quelques lettres ; celle qui est mise en avant (la branche courante) se réduit après les autres.
export component ChipView inherits Rectangle {
    in property <UiChip> chip;
    property <color> ink: chip.has-color ? chip.color : chip.tone > 0 ? Theme.tone(chip.tone) : Theme.text-dim;
    property <length> keep: (chip.glyph != "" ? 20px : 0px) + 8 * 6.5px + 12px;
    property <bool> has-icon: chip.icon != "";
    height: 20px;
    min-width: min(self.preferred-width, root.keep);
    preferred-width: min(150px, label.preferred-width + 12px + (root.has-icon ? 16px : 0px));
    max-width: self.preferred-width;
    // Dans une mise en page trop étroite, ce qui s'étire se réduit d'abord ; le reste ensuite, à parts égales.
    horizontal-stretch: chip.strong ? 0 : 1;
    border-radius: 6px;
    background: chip.strong ? root.ink : root.ink.with-alpha(0.14);
    border-width: chip.strong ? 0 : 1px;
    border-color: root.ink.with-alpha(0.5);
    if root.has-icon: Icon {
        x: 5px;
        kind: chip.icon;
        size: 13px;
        tint: !chip.strong ? root.ink : Theme.dark ? #121316 : #ffffff;
    }
    label := Text {
        x: root.has-icon ? 21px : 6px;
        width: parent.width - (root.has-icon ? 27px : 12px);
        text: chip.glyph != "" && !root.has-icon ? chip.glyph + " " + chip.text : chip.text;
        color: !chip.strong ? root.ink : Theme.dark ? #121316 : #ffffff;
        font-size: 11.5px;
        font-weight: chip.strong ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Une ligne d'étiquettes, puis un texte qui se coupe le premier (il s'étire cent fois plus qu'elles : il se réduit
// d'autant plus vite). Ce qui dépasse la largeur est coupé au bord : la ligne ne pousse pas les boutons voisins.
component ChipLine inherits Rectangle {
    in property <[UiChip]> chips;
    in property <string> text;
    min-width: 0;
    height: 20px;
    clip: true;
    HorizontalLayout {
        spacing: 5px;
        for c in root.chips: ChipView {
            chip: c;
        }
        Text {
            text: root.text;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0;
            horizontal-stretch: 100;
        }
    }
}

// Un bandeau : l'en-tête d'un groupe de lignes, qui se plie et se déplie d'un toucher n'importe où ; pastille de couleur,
// icône, titre, compte, pastille de ton (visible même plié), menu ⋮, et le chevron de pliage à droite (à la façon
// d'Android). Pendant une recherche, il reste ouvert.
export component BandHeader inherits Rectangle {
    in property <UiRow> item;
    callback toggle();
    callback menu();
    property <bool> foldable: item.fold == 1 || item.fold == 2;
    height: 48px;
    accessible-role: button;
    accessible-label: item.title + (item.detail != "" ? ", " + item.detail : "") + (item.badge != "" ? ", " + item.badge : "");
    accessible-expandable: root.foldable;
    accessible-expanded: item.fold == 1;
    accessible-action-default => {
        if root.foldable {
            root.toggle();
        }
    }
    accessible-action-expand => { root.toggle(); }
    Rectangle {
        x: Theme.pad - 8px;
        width: parent.width - 2 * (Theme.pad - 8px);
        y: 4px;
        height: parent.height - 8px;
        border-radius: Theme.radius-small;
        background: ta.pressed ? Theme.pressed : transparent;
        animate background { duration: 90ms; }
    }
    // Sous le contenu : ⋮ reçoit ses touchers, le reste plie le bandeau.
    ta := TouchArea {
        enabled: root.foldable;
        clicked => { root.toggle(); }
    }
    HorizontalLayout {
        padding-left: Theme.pad + 4px;
        padding-right: Theme.pad - 6px;
        spacing: 8px;
        if item.has-color: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: item.color;
            }
        }
        if item.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                kind: item.icon;
                size: 18px;
                tint: item.has-color ? item.color : Theme.text-dim;
            }
        }
        if item.icon == "" && item.glyph != "": Text {
            text: item.glyph;
            color: item.has-color ? item.color : Theme.text-dim;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: item.title;
            color: Theme.text;
            font-size: 14.5px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if item.detail != "": Text {
            text: item.detail;
            color: Theme.text-faint;
            font-size: 13px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if item.badge != "": VerticalLayout {
            alignment: center;
            Pill {
                text: item.badge;
                tone: item.tone > 0 ? item.tone : 1;
                soft: true;
            }
        }
        if item.busy: VerticalLayout {
            alignment: center;
            Busy { }
        }
        if item.acts.length > 0: VerticalLayout {
            alignment: center;
            IconButton {
                icon: "more";
                size: 40px;
                label: "Actions de « " + item.title + " »";
                tint: Theme.text-faint;
                clicked => { root.menu(); }
            }
        }
        if root.foldable: VerticalLayout {
            alignment: center;
            Icon {
                kind: "down";
                size: 22px;
                tint: Theme.text-dim;
                transform-rotation: item.fold == 1 ? 180deg : 0deg;
                animate transform-rotation { duration: 160ms; easing: ease-out; }
            }
        }
    }
}

// Le bouton visible d'une ligne, à droite, de 48 px : sur une ligne étroite (un téléphone), son glyphe seul dans un
// rond, pour laisser la place au titre ; sinon le glyphe et le libellé.
component TrailingButton inherits ActButton {
    in property <UiAct> act;
    in property <bool> narrow;
    pad: 12px;
    min-width: self.preferred-width;
    compact: root.narrow;
    text: root.act.label;
    glyph: root.act.glyph;
    icon: root.act.icon;
    style: root.act.style;
    busy: root.act.busy;
}

// L'action que fait le toucher d'une ligne, quand elle n'ouvre pas d'écran : le toucher agit sur le PC.
component TapPill inherits Rectangle {
    in property <UiAct> act;
    property <color> ink: act.style == 2 ? Theme.danger : Theme.accent;
    height: 28px;
    width: min(130px, content.preferred-width);
    border-radius: 14px;
    background: root.ink.with-alpha(0.14);
    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        if root.act.busy: VerticalLayout {
            alignment: center;
            Busy {
                size: 14px;
                tint: root.ink;
            }
        }
        if !root.act.busy && root.act.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                kind: root.act.icon;
                tint: root.ink;
                size: 15px;
            }
        }
        if !root.act.busy && root.act.icon == "" && root.act.glyph != "": Text {
            text: root.act.glyph;
            color: root.ink;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.act.label;
            color: root.ink;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Le signe à gauche d'une ligne : son icône Material (dans un rond de sa couleur quand elle en a une : un groupe de
// Fawkes), une ou deux lettres dans une pastille du ton (l'état d'un fichier), sinon le glyphe en texte.
component RowLead inherits Rectangle {
    in property <UiRow> item;
    property <color> ink: item.has-color ? item.color : item.tone >= 2 ? Theme.tone(item.tone) : Theme.text-dim;
    width: item.has-color ? 36px : 24px;
    height: self.width;
    if item.icon != "": Rectangle {
        border-radius: self.width / 2;
        background: item.has-color ? item.color.with-alpha(Theme.dark ? 0.22 : 0.14) : transparent;
        Icon {
            kind: item.icon;
            tint: root.ink;
            size: item.has-color ? 20px : 24px;
        }
    }
    if item.icon == "" && item.mark != "": Rectangle {
        y: (parent.height - self.height) / 2;
        height: 22px;
        border-radius: 6px;
        background: item.mark-tone == 0 ? Theme.surface-2 : Theme.tone(item.mark-tone).with-alpha(Theme.dark ? 0.24 : 0.13);
        Text {
            text: item.mark;
            color: item.mark-tone == 0 ? Theme.text-dim : Theme.tone-ink(item.mark-tone);
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if item.icon == "" && item.mark == "": Text {
        text: item.glyph;
        color: root.ink;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Une ligne de liste, dans une carte arrondie par section. Le toucher ouvre son écran, sinon fait son action (en
// pastille), sinon ouvre son menu ; l'appui long ou ⋮ ouvre le menu ; un bouton visible peut être à droite. Sans
// chevron ni tuile : un signe à gauche s'il y en a un, le texte, ce qui agit à droite.
export component RowView inherits Rectangle {
    in property <UiRow> item;
    // Le séparateur sous la ligne (sauf la dernière de sa carte) ; sans, quand ce qui suit lui appartient.
    in property <bool> separator: true;
    callback tapped();
    callback menu();
    callback trailing();
    callback haptic();
    property <bool> long-fired;
    property <bool> has-lead: item.glyph != "";
    // Où commence le texte : le séparateur part de là.
    property <length> text-x: root.has-lead ? (item.has-color ? 64px : 52px) : 16px;
    height: max(56px, content.preferred-height);
    accessible-role: list-item;
    accessible-label: (item.unread ? "Non lu, " : "") + item.title + (item.badge != "" ? ", " + item.badge : "") + (item.subtitle != "" ? ", " + item.subtitle : "") + (item.detail != "" ? ", " + item.detail : "");
    accessible-description: item.opens ? "Ouvre l'écran" : item.has-tap ? item.tap.label + " sur le PC" : "";
    accessible-action-default => { root.tapped(); }
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        background: ta.pressed && !root.long-fired ? Theme.pressed : Theme.surface;
        animate background { duration: 90ms; }
        border-top-left-radius: item.first ? Theme.radius : 0;
        border-top-right-radius: item.first ? Theme.radius : 0;
        border-bottom-left-radius: item.last ? Theme.radius : 0;
        border-bottom-right-radius: item.last ? Theme.radius : 0;
        clip: true;
        // Sous le contenu : les boutons de la ligne (⋮, bouton visible) reçoivent leurs touchers, le reste va à la ligne.
        ta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.long-fired = false;
                }
            }
            clicked => {
                if !root.long-fired {
                    root.tapped();
                }
            }
        }
        // Liseré du ton (échec, Claude attend…), quand aucune pastille ne le dit déjà.
        if item.tone >= 3 && item.badge == "": Rectangle {
            x: 0;
            width: 3px;
            background: Theme.tone(item.tone);
        }
        content := HorizontalLayout {
            padding-left: root.has-lead ? (item.has-color ? 14px : 16px) : 16px;
            padding-right: item.acts.length > 0 ? 2px : 14px;
            // Le bouton visible fait 40 px : la ligne garde ses 56 px.
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: root.has-lead ? (item.has-color ? 14px : 12px) : 0;
            if root.has-lead: VerticalLayout {
                alignment: center;
                RowLead {
                    item: root.item;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        // Le titre garde au moins 30 % de la ligne : les boutons et le texte à droite cèdent avant lui.
                        // En entier (`wrap`), il passe à la ligne autant qu'il faut.
                        Text {
                            text: item.title;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: item.unread ? 700 : 500;
                            wrap: item.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
                            overflow: elide;
                            min-width: min(self.preferred-width, root.width * 0.3);
                            horizontal-stretch: 1;
                        }
                        // Seulement s'il y en a une : même cachée, une pastille vide prendrait sa place au titre.
                        if item.badge != "": VerticalLayout {
                            alignment: start;
                            padding-top: 1px;
                            Pill {
                                text: item.badge;
                                tone: item.tone >= 2 ? item.tone : 1;
                                soft: true;
                            }
                        }
                    }
                    if item.chips.length > 0: VerticalLayout {
                        padding-top: 2px;
                        padding-bottom: 2px;
                        ChipLine {
                            chips: item.chips;
                        }
                    }
                    // Deux lignes au plus ; en entier (`wrap`), toutes (un nom de branche sans espace se coupe n'importe où).
                    if item.subtitle != "": Text {
                        text: item.subtitle;
                        color: item.unread ? Theme.text : Theme.text-dim;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: item.wrap ? 600px : 36px;
                    }
                }
                if item.detail != "" || item.unread: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    if item.detail != "": Text {
                        text: item.detail;
                        color: item.unread ? Theme.accent-ink : Theme.text-faint;
                        font-size: Theme.font-small;
                        font-weight: item.unread ? 600 : 400;
                        horizontal-alignment: right;
                        max-width: 110px;
                        min-width: item.has-trailing ? 0px : min(110px, self.preferred-width);
                        overflow: elide;
                    }
                    // Le point d'une entrée non lue.
                    if item.unread: HorizontalLayout {
                        alignment: end;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.accent;
                        }
                    }
                }
            }
            if item.has-tap && !item.opens: VerticalLayout {
                alignment: center;
                padding-left: 8px;
                TapPill {
                    act: item.tap;
                }
            }
            // Les boutons de droite, serrés : ⋮ a déjà sa marge dans sa cible.
            if item.has-trailing || item.busy || item.acts.length > 0: HorizontalLayout {
                spacing: 2px;
                padding-left: 6px;
                if item.has-trailing: VerticalLayout {
                    alignment: center;
                    TrailingButton {
                        act: item.trailing;
                        narrow: root.width < 480px;
                        clicked => { root.trailing(); }
                    }
                }
                if item.busy && !(item.has-tap && item.tap.busy): VerticalLayout {
                    alignment: center;
                    Busy { }
                }
                if item.acts.length > 0: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "more";
                        size: 40px;
                        label: "Actions de « " + item.title + " »";
                        tint: Theme.text-faint;
                        clicked => { root.menu(); }
                    }
                }
            }
        }
        // Une opération en cours sur la ligne : une barre en bas.
        if item.has-progress: ThinProgress {
            x: root.text-x;
            y: parent.height - 7px;
            width: parent.width - root.text-x - 14px;
            value: item.value;
            indeterminate: item.indeterminate;
            tint: item.tone >= 3 ? Theme.tone(item.tone) : Theme.accent;
        }
        // Séparateur sous la ligne, sauf la dernière de la section, aligné sur le texte.
        if !item.last && root.separator: Rectangle {
            x: root.text-x;
            y: parent.height - 1px;
            height: 1px;
            width: parent.width - root.text-x;
            background: Theme.border;
        }
        Timer {
            interval: 520ms;
            running: ta.pressed && !root.long-fired && item.acts.length > 0;
            triggered => {
                root.long-fired = true;
                root.haptic();
                root.menu();
            }
        }
    }
}

// Une ligne de commit : dense, la colonne du graphe sur toute la hauteur (les traits des lignes voisines se
// raccordent). Le titre a toute la largeur de sa ligne, avec sa pastille ; dessous, les étiquettes, puis le sous-titre
// (auteur, date) et le texte à droite (identifiant court), qui leur cèdent la place.
export component CommitRowView inherits Rectangle {
    in property <UiRow> item;
    callback tapped();
    callback menu();
    callback trailing();
    callback haptic();
    property <bool> long-fired;
    property <string> second: item.subtitle + (item.subtitle != "" && item.detail != "" ? " · " : "") + item.detail;
    height: 56px;
    accessible-role: list-item;
    accessible-label: item.title + (item.badge != "" ? ", " + item.badge : "") + (root.second != "" ? ", " + root.second : "");
    accessible-description: item.opens ? "Ouvre l'écran" : item.has-tap ? item.tap.label + " sur le PC" : "";
    accessible-action-default => { root.tapped(); }
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        background: ta.pressed && !root.long-fired ? Theme.pressed : Theme.surface;
        animate background { duration: 90ms; }
        border-top-left-radius: item.first ? Theme.radius : 0;
        border-top-right-radius: item.first ? Theme.radius : 0;
        border-bottom-left-radius: item.last ? Theme.radius : 0;
        border-bottom-right-radius: item.last ? Theme.radius : 0;
        clip: true;
        // Sous le contenu, sur toute la ligne : ⋯ et le bouton visible reçoivent leurs touchers (par-dessus, la zone
        // couvrait ⋯ dès que la ligne avait aussi un chevron), le reste va à la ligne.
        ta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.long-fired = false;
                }
            }
            clicked => {
                if !root.long-fired {
                    root.tapped();
                }
            }
        }
        Rectangle {
            x: 2px;
            width: item.graph-w;
            clip: true;
            // Les commandes sont en pixels de la cellule, dessinées telles quelles : ajustées à la taille (le défaut),
            // elles seraient réduites de l'épaisseur du trait et s'arrêteraient avant le bord de la ligne.
            for seg in item.segs: Path {
                x: 0;
                y: 0;
                width: item.graph-w;
                height: 56px;
                fit: preserve;
                commands: seg.d;
                fill: transparent;
                stroke: Theme.lane(seg.lane);
                stroke-width: 2px;
            }
            // Le nœud : un disque (fusion : plus petit), un anneau pour HEAD, atténué s'il est perdu, carré pour une
            // remise.
            if item.node >= 0: Rectangle {
                property <length> r: item.node == 2 ? 6px : item.node == 1 ? 3.8px : 4.6px;
                property <color> ink: Theme.lane(item.node-lane);
                x: item.node-x - self.r;
                y: parent.height / 2 - self.r;
                width: 2 * self.r;
                height: 2 * self.r;
                border-radius: item.node == 4 ? 2px : self.r;
                background: item.node == 2 || item.node == 3 ? Theme.surface : self.ink;
                border-width: item.node == 2 ? 2px : 1.5px;
                border-color: item.node == 2 || item.node == 3 ? self.ink : Theme.surface;
                opacity: item.node == 3 ? 0.5 : 1;
                if item.node == 2: Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: parent.ink;
                }
            }
        }
        HorizontalLayout {
            padding-left: item.graph-w + 8px;
            padding-right: 6px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: item.title;
                        color: item.node == 3 ? Theme.text-dim : Theme.text;
                        font-size: 14.5px;
                        font-weight: item.node == 2 ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0;
                        horizontal-stretch: 1;
                    }
                    if item.badge != "": VerticalLayout {
                        alignment: center;
                        Pill {
                            text: item.badge;
                            tone: item.tone >= 3 ? item.tone : 1;
                            soft: true;
                        }
                    }
                }
                if item.chips.length > 0: ChipLine {
                    chips: item.chips;
                    text: root.second;
                }
                if item.chips.length == 0 && root.second != "": Text {
                    text: root.second;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    overflow: elide;
                    min-width: 0;
                }
            }
            if item.has-tap && !item.opens: VerticalLayout {
                alignment: center;
                TapPill {
                    act: item.tap;
                }
            }
            if item.has-trailing: VerticalLayout {
                alignment: center;
                TrailingButton {
                    act: item.trailing;
                    narrow: root.width < 480px;
                    clicked => { root.trailing(); }
                }
            }
            if item.busy && !(item.has-tap && item.tap.busy): VerticalLayout {
                alignment: center;
                Busy { }
            }
            if item.acts.length > 0 && !item.opens: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "more";
                    size: 40px;
                    label: "Actions de « " + item.title + " »";
                    tint: Theme.text-faint;
                    clicked => { root.menu(); }
                }
            }
        }
        // Une opération en cours sur la ligne : une barre en bas, sous le texte.
        if item.has-progress: ThinProgress {
            x: item.graph-w + 8px;
            y: parent.height - 6px;
            width: parent.width - item.graph-w - 8px - 14px;
            value: item.value;
            indeterminate: item.indeterminate;
            tint: item.tone >= 3 ? Theme.tone(item.tone) : Theme.accent;
        }
        Timer {
            interval: 520ms;
            running: ta.pressed && !root.long-fired && item.acts.length > 0;
            triggered => {
                root.long-fired = true;
                root.haptic();
                root.menu();
            }
        }
    }
}

// Un bandeau d'information ou d'alerte ; avec une progression, une opération en cours, sa barre et ses boutons
// (« Annuler »).
export component NoteView inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    in property <bool> has-progress;
    in property <bool> indeterminate;
    in property <float> value;
    in property <[UiAct]> acts;
    callback act(UiAct);
    height: layout.preferred-height + 12px;
    Rectangle {
        x: Theme.pad;
        y: 6px;
        width: parent.width - 2 * Theme.pad;
        height: parent.height - 12px;
        border-radius: Theme.radius-small;
        background: Theme.tone(root.tone).with-alpha(Theme.dark ? 0.16 : 0.10);
        border-width: 1px;
        border-color: Theme.tone(root.tone).with-alpha(0.35);
        layout := HorizontalLayout {
            padding: 12px;
            spacing: 10px;
            Rectangle {
                width: 4px;
                border-radius: 2px;
                background: Theme.tone(root.tone);
            }
            VerticalLayout {
                spacing: 10px;
                alignment: center;
                Text {
                    text: root.text;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.has-progress: ThinProgress {
                    value: root.value;
                    indeterminate: root.indeterminate;
                    tint: Theme.tone(root.tone);
                }
                if root.acts.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for a in root.acts: ActButton {
                        text: a.label;
                        glyph: a.glyph;
                        icon: a.icon;
                        style: a.style;
                        busy: a.busy;
                        clicked => { root.act(a); }
                    }
                }
            }
        }
    }
}

export component MeterView inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <float> value;
    in property <int> tone;
    height: 64px;
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        height: parent.height - 8px;
        y: 4px;
        border-radius: Theme.radius-small;
        background: Theme.surface;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: root.label;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 500;
                }
                Text {
                    text: root.value-text;
                    color: Theme.tone(root.tone);
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.surface-2;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, root.value));
                    border-radius: 3px;
                    background: Theme.tone(root.tone);
                    animate width { duration: 300ms; easing: ease-out; }
                }
            }
        }
    }
}

export component TextBlock inherits Rectangle {
    in property <string> text;
    in property <bool> mono;
    height: t.preferred-height + 24px;
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        y: 6px;
        height: parent.height - 12px;
        border-radius: Theme.radius-small;
        background: root.mono ? Theme.term-bg : transparent;
        t := Text {
            x: 12px;
            y: 6px;
            width: parent.width - 24px;
            text: root.text;
            color: root.mono ? Theme.term-fg : Theme.text;
            font-family: root.mono ? "Hack" : "";
            font-size: root.mono ? 11.5px : 14px;
            wrap: word-wrap;
        }
    }
}

// L'en-tête d'un diff : ses ajouts et retraits, et le retour à la ligne (choisi sur le téléphone).
export component DiffBarView inherits Rectangle {
    in property <UiRow> item;
    callback toggle-wrap();
    height: 44px;
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        background: Theme.surface-2;
        border-top-left-radius: Theme.radius-small;
        border-top-right-radius: Theme.radius-small;
        border-bottom-left-radius: item.last ? Theme.radius-small : 0;
        border-bottom-right-radius: item.last ? Theme.radius-small : 0;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 8px;
            Text {
                text: item.title;
                color: Theme.text-dim;
                font-family: "Hack";
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: wrap-label.preferred-width + 24px;
                accessible-role: checkbox;
                accessible-label: "Retour à la ligne";
                accessible-checkable: true;
                accessible-checked: item.wrap;
                accessible-action-default => { root.toggle-wrap(); }
                Rectangle {
                    y: 6px;
                    height: parent.height - 12px;
                    border-radius: self.height / 2;
                    background: item.wrap ? Theme.accent-soft : wrap-ta.pressed ? Theme.pressed : transparent;
                }
                wrap-label := Text {
                    text: "↩ Retour à la ligne";
                    color: item.wrap ? Theme.accent : Theme.text-dim;
                    font-size: 12.5px;
                    font-weight: item.wrap ? 700 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                wrap-ta := TouchArea {
                    clicked => { root.toggle-wrap(); }
                }
            }
        }
    }
}

// Une ligne de diff, dans un bloc à chasse fixe : numéros (ancien, nouveau) en gouttière ; coupée, ou passant à la
// ligne si on l'a choisi ; un en-tête (`@@ … @@`) mis en avant.
export component DiffLineView inherits Rectangle {
    in property <UiRow> item;
    property <int> kind: item.tone;
    property <length> cw: 12px * 0.602;
    property <length> numbers-w: item.gutter > 0 ? 2 * item.gutter * root.cw + 14px : 0px;
    height: (item.wrap ? max(18px, t.preferred-height + 2px) : 18px) + (item.last ? 8px : 0);
    Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        background: root.kind == 1 ? Theme.ok.with-alpha(0.16) : root.kind == 2 ? Theme.danger.with-alpha(0.16) : root.kind == 3 ? Theme.accent-soft : Theme.term-bg;
        border-bottom-left-radius: item.last ? Theme.radius-small : 0;
        border-bottom-right-radius: item.last ? Theme.radius-small : 0;
        clip: true;
        if item.gutter > 0: Text {
            x: 4px;
            y: 1px;
            width: item.gutter * root.cw;
            text: item.subtitle;
            color: Theme.text-faint;
            font-family: "Hack";
            font-size: 12px;
            horizontal-alignment: right;
        }
        if item.gutter > 0: Text {
            x: 8px + item.gutter * root.cw;
            y: 1px;
            width: item.gutter * root.cw;
            text: item.detail;
            color: Theme.text-faint;
            font-family: "Hack";
            font-size: 12px;
            horizontal-alignment: right;
        }
        t := Text {
            x: 8px + root.numbers-w;
            y: 1px;
            width: parent.width - 16px - root.numbers-w;
            text: item.title;
            color: root.kind == 1 ? Theme.ok : root.kind == 2 ? Theme.danger : root.kind == 3 ? Theme.accent : Theme.term-fg;
            font-family: "Hack";
            font-size: 12px;
            font-weight: root.kind == 3 ? 700 : 400;
            wrap: item.wrap ? TextWrap.char-wrap : TextWrap.no-wrap;
            overflow: item.wrap ? TextOverflow.clip : TextOverflow.elide;
        }
    }
}

export component EmptyView inherits Rectangle {
    in property <string> text;
    height: 96px;
    Text {
        text: root.text;
        color: Theme.text-faint;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 48px;
    }
}

// Une action de la barre du haut en icône : son icône Material, sinon son glyphe (rouge si elle est dangereuse), son
// libellé pour le lecteur d'écran, un indicateur quand elle est en cours.
component GlyphButton inherits Rectangle {
    in property <UiAct> act;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ta.pressed ? Theme.pressed : transparent;
    accessible-role: button;
    accessible-label: root.act.label;
    accessible-enabled: !root.act.busy;
    accessible-action-default => { root.clicked(); }
    if root.act.busy: Busy { }
    if !root.act.busy && root.act.icon != "": Icon {
        kind: root.act.icon;
        tint: root.act.style == 2 ? Theme.danger : Theme.text;
    }
    if !root.act.busy && root.act.icon == "": Text {
        text: root.act.glyph;
        color: root.act.style == 2 ? Theme.danger : Theme.text-dim;
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: !root.act.busy;
        clicked => { root.clicked(); }
    }
}

// La barre du haut : retour, titre et sous-titre, actions (`bar` : en icônes, ou une seule en clair ; `acts` : le
// menu ⋯). Tout se centre sur la bande des boutons ronds, en haut (la flèche de retour, ⋯) : le titre et les icônes
// sur la même ligne qu'eux, quelle que soit la police du téléphone ; le sous-titre dessous, sous le titre.
export component TopBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> can-back;
    in property <[UiAct]> bar;
    in property <[UiAct]> acts;
    in property <bool> online: true;
    // « Montrer sur le PC » : une icône, à part des autres actions.
    in property <bool> show-pc;
    callback back();
    callback act(UiAct);
    callback more();
    callback pc();
    height: 60px;
    background: Theme.bg;
    // La bande des boutons ronds, en haut de la barre : tout s'y centre.
    property <length> band: 44px;
    HorizontalLayout {
        padding-left: root.can-back ? 4px : Theme.pad;
        padding-right: 4px;
        spacing: 4px;
        if root.can-back: VerticalLayout {
            alignment: start;
            IconButton {
                icon: "back";
                label: "Retour";
                clicked => { root.back(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            title-text := Text {
                x: 0;
                y: (root.band - self.height) / 2;
                width: parent.width;
                height: self.preferred-height;
                text: root.title;
                color: Theme.text;
                font-size: root.subtitle == "" ? 22px : 18px;
                font-weight: 700;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                x: 0;
                y: title-text.y + title-text.height;
                width: parent.width;
                height: self.preferred-height;
                text: root.subtitle;
                color: Theme.text-dim;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        if root.show-pc: VerticalLayout {
            alignment: start;
            IconButton {
                icon: "pc";
                label: "Montrer sur le PC";
                tint: Theme.text-dim;
                clicked => { root.pc(); }
            }
        }
        // Une action seule : en clair (rouge si elle est dangereuse), son icône devant, son bord droit aligné sur celui
        // des cartes.
        if root.bar.length == 1 && root.acts.length == 0: VerticalLayout {
            alignment: start;
            padding-right: Theme.pad - 4px;
            Rectangle {
                width: first-row.preferred-width + 24px;
                height: root.band;
                accessible-role: button;
                accessible-label: root.bar[0].label;
                accessible-action-default => { root.act(root.bar[0]); }
                Rectangle {
                    y: 4px;
                    height: 36px;
                    border-radius: 18px;
                    background: first-ta.pressed ? Theme.pressed : root.bar[0].style == 2 ? Theme.danger.with-alpha(0.14) : Theme.surface-2;
                }
                first-row := HorizontalLayout {
                    x: 12px;
                    width: parent.width - 24px;
                    spacing: 6px;
                    alignment: center;
                    opacity: root.bar[0].busy ? 0 : 1;
                    if root.bar[0].icon != "": VerticalLayout {
                        alignment: center;
                        Icon {
                            kind: root.bar[0].icon;
                            tint: root.bar[0].style == 2 ? Theme.danger : Theme.accent;
                            size: 18px;
                        }
                    }
                    Text {
                        text: root.bar[0].glyph != "" && root.bar[0].icon == "" ? root.bar[0].glyph + " " + root.bar[0].label : root.bar[0].label;
                        color: root.bar[0].style == 2 ? Theme.danger : Theme.accent;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                if root.bar[0].busy: Busy {
                    size: 18px;
                }
                first-ta := TouchArea {
                    enabled: !root.bar[0].busy;
                    clicked => { root.act(root.bar[0]); }
                }
            }
        }
        // Sinon, jusqu'à deux en icônes, les autres dans le menu.
        if root.bar.length > 1 || root.acts.length > 0: HorizontalLayout {
            spacing: 2px;
            for a in root.bar: VerticalLayout {
                alignment: start;
                GlyphButton {
                    act: a;
                    clicked => { root.act(a); }
                }
            }
        }
        if root.acts.length > 0: VerticalLayout {
            alignment: start;
            IconButton {
                icon: "more";
                label: "Plus d'actions";
                clicked => { root.more(); }
            }
        }
    }
}

export struct NavItem {
    key: string,
    label: string,
    icon: string,
    module: ModuleItem,
    is-module: bool,
    badge: string,
    badge-tone: int,
}

// La barre du bas.
export component BottomNav inherits Rectangle {
    in property <[NavItem]> items;
    in property <string> current;
    callback select(string);
    height: 64px;
    accessible-role: tab-list;
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        for item in root.items: Rectangle {
            horizontal-stretch: 1;
            property <bool> on: item.key == root.current;
            accessible-role: tab;
            accessible-label: item.badge != "" ? item.label + ", " + item.badge : item.label;
            accessible-item-selected: self.on;
            accessible-action-default => { root.select(item.key); }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Rectangle {
                    height: 30px;
                    Rectangle {
                        width: 60px;
                        height: 30px;
                        border-radius: 15px;
                        background: on ? Theme.accent-soft : transparent;
                        animate background { duration: 150ms; }
                    }
                    // Les modules gardent leur signe d'origine : leur logo, sinon leur initiale.
                    if item.is-module: ModuleAvatar {
                        module: item.module;
                        size: 24px;
                        original: true;
                    }
                    if !item.is-module: Icon {
                        kind: item.icon;
                        size: 24px;
                        filled: on;
                        tint: on ? Theme.accent-ink : Theme.text-dim;
                    }
                    Pill {
                        x: parent.width / 2 + 4px;
                        y: -3px;
                        height: 16px;
                        text: item.badge;
                        tone: item.badge-tone;
                    }
                }
                Text {
                    text: item.label;
                    color: on ? Theme.text : Theme.text-dim;
                    font-size: 11.5px;
                    font-weight: on ? 700 : 500;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea {
                clicked => { root.select(item.key); }
            }
        }
    }
}

// Une feuille du bas : un titre et des actions (les dangereuses à la fin, séparées des autres), puis « Annuler » ;
// elle défile au-delà des trois quarts de l'écran.
export component ActionSheet inherits Rectangle {
    in property <string> title;
    in property <[UiAct]> acts;
    in property <length> bottom-inset;
    callback chosen(UiAct);
    callback dismissed();
    background: Theme.scrim;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    sheet := Rectangle {
        y: parent.height - self.height;
        height: min(col.preferred-height + head.preferred-height, root.height * 0.75) + root.bottom-inset;
        background: Theme.surface;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        TouchArea { }
        head := VerticalLayout {
            y: 0;
            height: self.preferred-height;
            padding-top: 8px;
            alignment: start;
            Rectangle {
                height: 18px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.border;
                }
            }
            if root.title != "": Text {
                text: root.title;
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
                height: 32px;
            }
        }
        Flickable {
            y: head.height;
            height: parent.height - head.height - root.bottom-inset;
            content-height: col.preferred-height;
            col := VerticalLayout {
                padding-bottom: 8px;
                alignment: start;
                for a[i] in root.acts: Rectangle {
                    height: a.style == 2 && i > 0 && root.acts[i - 1].style != 2 ? 63px : 54px;
                    // Les actions dangereuses, à la fin : séparées des autres.
                    if a.style == 2 && i > 0 && root.acts[i - 1].style != 2: Rectangle {
                        x: 24px;
                        y: 4px;
                        width: parent.width - 48px;
                        height: 1px;
                        background: Theme.border;
                    }
                    Rectangle {
                        y: parent.height - 54px;
                        height: 54px;
                        background: item-ta.pressed ? Theme.pressed : transparent;
                        opacity: a.busy ? 0.55 : 1;
                        accessible-role: button;
                        accessible-label: a.label;
                        accessible-enabled: !a.busy;
                        accessible-action-default => { root.chosen(a); }
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 16px;
                            if a.busy: VerticalLayout {
                                alignment: center;
                                width: 24px;
                                Busy { }
                            }
                            if !a.busy && a.icon != "": VerticalLayout {
                                alignment: center;
                                width: 24px;
                                Icon {
                                    kind: a.icon;
                                    tint: a.style == 2 ? Theme.danger : Theme.text-dim;
                                }
                            }
                            if !a.busy && a.icon == "": Text {
                                text: a.glyph;
                                width: 24px;
                                color: a.style == 2 ? Theme.danger : Theme.text-dim;
                                font-size: 18px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: a.label;
                                color: a.style == 2 ? Theme.danger : Theme.text;
                                font-size: 16px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        item-ta := TouchArea {
                            enabled: !a.busy;
                            clicked => { root.chosen(a); }
                        }
                    }
                }
                Rectangle {
                    height: 54px;
                    background: cancel-ta.pressed ? Theme.pressed : transparent;
                    accessible-role: button;
                    accessible-label: "Annuler";
                    accessible-action-default => { root.dismissed(); }
                    Text {
                        text: "Annuler";
                        color: Theme.text-dim;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cancel-ta := TouchArea {
                        clicked => { root.dismissed(); }
                    }
                }
            }
        }
    }
}

// Les deux boutons d'un dialogue : côte à côte à droite ; l'un sous l'autre, le principal en haut et sur toute la
// largeur, quand un long libellé (« Fusionner dans mobile-ergonomie », « Ajouter un dépôt existant… ») ne tient pas
// à côté d'« Annuler » (côte à côte, les deux se coupaient : « Ann… »).
export component DialogButtons inherits Rectangle {
    in property <string> ok-text;
    in property <int> ok-style: 1;
    callback answered(bool);
    // Les largeurs voulues des deux boutons, mesurées hors de la mise en page.
    property <bool> side-by-side: cancel-probe.preferred-width + ok-probe.preferred-width + 10px <= root.width;
    height: root.side-by-side ? 48px : 2 * 48px + 10px;
    cancel-probe := ActButton {
        visible: false;
        text: "Annuler";
    }
    ok-probe := ActButton {
        visible: false;
        text: root.ok-text;
    }
    if root.side-by-side: HorizontalLayout {
        spacing: 10px;
        alignment: end;
        ActButton {
            text: "Annuler";
            clicked => { root.answered(false); }
        }
        ActButton {
            text: root.ok-text;
            style: root.ok-style;
            clicked => { root.answered(true); }
        }
    }
    if !root.side-by-side: VerticalLayout {
        spacing: 10px;
        ActButton {
            text: root.ok-text;
            style: root.ok-style;
            clicked => { root.answered(true); }
        }
        ActButton {
            text: "Annuler";
            clicked => { root.answered(false); }
        }
    }
}

// Une question avant d'agir.
export component ConfirmDialog inherits Rectangle {
    in property <string> text;
    in property <string> ok-text: "Confirmer";
    in property <bool> danger;
    callback answered(bool);
    background: Theme.scrim;
    TouchArea {
        clicked => { root.answered(false); }
    }
    Rectangle {
        width: min(parent.width - 48px, 380px);
        height: col.preferred-height;
        border-radius: 22px;
        background: Theme.surface;
        TouchArea { }
        col := VerticalLayout {
            padding: 24px;
            spacing: 22px;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 17px;
                wrap: word-wrap;
            }
            DialogButtons {
                ok-text: root.ok-text;
                ok-style: root.danger ? 2 : 1;
                answered(yes) => { root.answered(yes); }
            }
        }
    }
}

// Une bulle en bas de l'écran : trois lignes au plus ; dépliée (une erreur touchée), le texte entier, qui défile s'il
// dépasse la hauteur permise. Un toucher la referme.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    in property <bool> expanded;
    in property <length> max-text: 400px;
    callback tapped();
    // La hauteur de trois lignes, mesurée : elle dépend de la police du téléphone (une ligne seule est plus haute que
    // l'écart entre deux lignes : trois fois une ligne laissait voir le haut de la quatrième).
    property <length> three-lines: probe.preferred-height;
    height: min(label.preferred-height, root.expanded ? root.max-text : root.three-lines) + 24px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-action-default => { root.tapped(); }
    border-radius: 14px;
    background: Theme.dark ? #3a3e48 : #2b2f36;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000055;
    probe := Text {
        visible: false;
        text: "X\nX\nX";
        font-size: 14px;
    }
    // Sous le texte : les marges et la pastille de ton se touchent aussi.
    TouchArea {
        clicked => { root.tapped(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 6px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.tone(root.tone);
            }
        }
        Rectangle {
            clip: true;
            flick := Flickable {
                interactive: root.expanded;
                content-width: self.width;
                content-height: max(self.height, label.preferred-height);
                label := Text {
                    y: 0;
                    width: flick.width;
                    text: root.text;
                    color: #f2f3f5;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                // Un toucher sans glisser : la bulle se déplie ou se referme ; glisser fait défiler le texte déplié.
                TouchArea {
                    width: flick.content-width;
                    height: flick.content-height;
                    clicked => { root.tapped(); }
                }
            }
        }
    }
}
